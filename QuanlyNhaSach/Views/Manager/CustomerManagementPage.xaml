<Page x:Class="QuanlyNhaSach.Views.Manager.CustomerManagementPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d"
      Title="Quản lý khách hàng — Cổng Quản Trị"
      Background="{StaticResource SubtleSurfaceBrush}">

    <Grid Margin="32,26">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- A. Header -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <StackPanel>
                <TextBlock Text="Quản lý khách hàng"
                           Style="{StaticResource PageTitleStyle}"/>
                <TextBlock Text="Tra cứu thông tin khách hàng, khóa/mở khóa quyền đăng nhập và cấp lại mật khẩu tạm thời (Mô phỏng)."
                           FontSize="13.5"
                           Foreground="{StaticResource MutedTextBrush}"
                           Margin="0,4,0,0"/>
            </StackPanel>
        </Grid>

        <!-- B. Search & Status Filter Toolbar -->
        <Border Grid.Row="1"
                Style="{StaticResource CardPanelStyle}"
                Padding="18,14"
                Margin="0,0,0,18">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2.2*"/>
                    <ColumnDefinition Width="1.1*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,14,0">
                    <TextBlock Text="Tìm kiếm khách hàng (Mã KH, Họ tên, Tên đăng nhập, Số điện thoại)"
                               Style="{StaticResource FormFieldLabelStyle}"/>
                    <TextBox Text="{Binding SearchKeyword, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource FormTextBoxStyle}"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="0,0,14,0">
                    <TextBlock Text="Trạng thái tài khoản"
                               Style="{StaticResource FormFieldLabelStyle}"/>
                    <ComboBox ItemsSource="{Binding StatusFilterOptions}"
                              SelectedItem="{Binding SelectedStatusFilter}"
                              Style="{StaticResource FormComboBoxStyle}"/>
                </StackPanel>

                <Button Grid.Column="2"
                        Content="Đặt lại"
                        Command="{Binding ClearFiltersCommand}"
                        Style="{StaticResource SecondaryOutlineButtonStyle}"
                        VerticalAlignment="Bottom"
                        Margin="0,0,14,0"
                        Padding="14,9"/>

                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Bottom">
                    <Border Background="{StaticResource SuccessSoftBgBrush}" CornerRadius="8" Padding="10,8" Margin="0,0,8,0">
                        <TextBlock Text="{Binding ActiveCustomerCount, StringFormat='Hoạt động: {0}'}"
                                   FontSize="12"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource SuccessGreenBrush}"/>
                    </Border>
                    <Border Background="{StaticResource ErrorSoftBgBrush}" CornerRadius="8" Padding="10,8">
                        <TextBlock Text="{Binding LockedCustomerCount, StringFormat='Đã khóa: {0}'}"
                                   FontSize="12"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource ErrorRedBrush}"/>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- C. Customers DataGrid -->
        <Border Grid.Row="2" Style="{StaticResource CardPanelStyle}" Padding="16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Text="{Binding TotalDisplayedCount, StringFormat='Danh sách hiển thị: {0} khách hàng'}"
                           FontSize="13"
                           FontWeight="Bold"
                           Foreground="{StaticResource CharcoalTextBrush}"
                           Margin="4,0,0,10"/>

                <DataGrid Grid.Row="1"
                          ItemsSource="{Binding DisplayedCustomers}"
                          Style="{StaticResource AdminDataGridStyle}">
                    <DataGrid.Columns>
                        <!-- 1. Customer ID -->
                        <DataGridTextColumn Header="Mã KH" Binding="{Binding UserCode}" Width="90"/>

                        <!-- 2. Full Name -->
                        <DataGridTemplateColumn Header="Họ và tên khách hàng" Width="1.4*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding HoTen}"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource CharcoalTextBrush}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- 3. Username -->
                        <DataGridTextColumn Header="Tên đăng nhập" Binding="{Binding Username}" Width="1.4*"/>

                        <!-- 4. Phone Number -->
                        <DataGridTextColumn Header="Số điện thoại" Binding="{Binding SDT}" Width="120"/>

                        <!-- 5. Address -->
                        <DataGridTextColumn Header="Địa chỉ" Binding="{Binding DiaChi}" Width="1.6*"/>

                        <!-- 6. Account Status -->
                        <DataGridTemplateColumn Header="Trạng thái" Width="125">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="6"
                                            Padding="10,4"
                                            HorizontalAlignment="Left"
                                            Background="{Binding IsActive, Converter={StaticResource AccountStatusBadgeBackgroundConverter}}">
                                        <TextBlock Text="{Binding AccountStatusLabel}"
                                                   FontSize="12"
                                                   FontWeight="Bold"
                                                   Foreground="{Binding IsActive, Converter={StaticResource AccountStatusBadgeForegroundConverter}}"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- 7. Actions -->
                        <DataGridTemplateColumn Header="Thao tác" Width="300">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="{Binding ToggleLockActionText}"
                                                Command="{Binding DataContext.ToggleCustomerLockCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource SecondaryOutlineButtonStyle}"
                                                Padding="10,5"
                                                Margin="0,0,8,0"/>
                                        <Button Content="Cấp lại mật khẩu"
                                                Command="{Binding DataContext.ResetCustomerPasswordCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource PrimaryCtaButtonStyle}"
                                                FontSize="12.5"
                                                Padding="11,5"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>
    </Grid>
</Page>
