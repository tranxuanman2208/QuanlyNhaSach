<Page x:Class="QuanlyNhaSach.Views.Manager.SupplierManagementPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d"
      Title="Nhà cung cấp — Cổng Quản Trị"
      Background="{StaticResource SubtleSurfaceBrush}">

    <Grid>
        <!-- ==================== 1. MAIN PAGE CONTENT ==================== -->
        <Grid Margin="32,26">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- A. Header & Primary CTA (+ Thêm nhà cung cấp) -->
            <Grid Grid.Row="0" Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Nhà cung cấp"
                               Style="{StaticResource PageTitleStyle}"/>
                    <TextBlock Text="Quản lý danh mục đối tác cung ứng sách, thông tin liên hệ và bảo toàn tham chiếu phiếu nhập lịch sử (UC12)."
                               FontSize="13.5"
                               Foreground="{StaticResource MutedTextBrush}"
                               Margin="0,4,0,0"/>
                </StackPanel>

                <Button Grid.Column="1"
                        Content="+ Thêm nhà cung cấp"
                        Command="{Binding OpenAddSupplierDialogCommand}"
                        Style="{StaticResource PrimaryCtaButtonStyle}"
                        Padding="18,11"
                        VerticalAlignment="Center"/>
            </Grid>

            <!-- B. Search Toolbar -->
            <Border Grid.Row="1"
                    Style="{StaticResource CardPanelStyle}"
                    Padding="18,14"
                    Margin="0,0,0,18">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,14,0">
                        <TextBlock Text="Tìm kiếm nhà cung cấp (Mã NCC, Tên nhà cung cấp, Số điện thoại, Email, Địa chỉ)"
                                   Style="{StaticResource FormFieldLabelStyle}"/>
                        <TextBox Text="{Binding SearchKeyword, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource FormTextBoxStyle}"/>
                    </StackPanel>

                    <Button Grid.Column="1"
                            Content="Xóa tìm kiếm"
                            Command="{Binding ClearSearchCommand}"
                            Style="{StaticResource SecondaryOutlineButtonStyle}"
                            VerticalAlignment="Bottom"
                            Padding="16,9"/>
                </Grid>
            </Border>

            <!-- C. Suppliers DataGrid -->
            <Border Grid.Row="2" Style="{StaticResource CardPanelStyle}" Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="{Binding TotalDisplayedCount, StringFormat='Danh sách hiển thị: {0} nhà cung cấp'}"
                               FontSize="13"
                               FontWeight="Bold"
                               Foreground="{StaticResource CharcoalTextBrush}"
                               Margin="4,0,0,10"/>

                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding DisplayedSuppliers}"
                              Style="{StaticResource AdminDataGridStyle}">
                        <DataGrid.Columns>
                            <!-- 1. Supplier ID -->
                            <DataGridTextColumn Header="Mã NCC" Binding="{Binding SupplierCode}" Width="95"/>

                            <!-- 2. Supplier Name -->
                            <DataGridTemplateColumn Header="Tên nhà cung cấp" Width="1.7*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding TenNCC}"
                                                   FontWeight="Bold"
                                                   Foreground="{StaticResource CharcoalTextBrush}"
                                                   TextWrapping="Wrap"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- 3. Phone -->
                            <DataGridTextColumn Header="Số điện thoại" Binding="{Binding SDT}" Width="125"/>

                            <!-- 4. Email -->
                            <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="1.3*"/>

                            <!-- 5. Address -->
                            <DataGridTextColumn Header="Địa chỉ" Binding="{Binding DiaChi}" Width="1.7*"/>

                            <!-- 6. Status -->
                            <DataGridTemplateColumn Header="Trạng thái" Width="125">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="6"
                                                Padding="10,4"
                                                HorizontalAlignment="Left"
                                                Background="{Binding IsActive, Converter={StaticResource AccountStatusBadgeBackgroundConverter}}">
                                            <TextBlock Text="{Binding StatusText}"
                                                       FontSize="12"
                                                       FontWeight="Bold"
                                                       Foreground="{Binding IsActive, Converter={StaticResource AccountStatusBadgeForegroundConverter}}"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- 7. Actions -->
                            <DataGridTemplateColumn Header="Thao tác" Width="210">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="Sửa"
                                                    Command="{Binding DataContext.OpenEditSupplierDialogCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource SecondaryOutlineButtonStyle}"
                                                    Padding="12,5"
                                                    Margin="0,0,8,0"/>
                                            <Button Content="{Binding ToggleStatusActionText}"
                                                    Command="{Binding DataContext.ToggleSupplierStatusCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource RemoveItemButtonStyle}"
                                                    Padding="10,5"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>

        <!-- ==================== 2. ADD / EDIT SUPPLIER MODAL DIALOG ==================== -->
        <Grid Background="#7F0F172A"
              Visibility="{Binding IsSupplierDialogOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Border Width="520"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Style="{StaticResource CardPanelStyle}"
                    Padding="28,24">
                <StackPanel>
                    <TextBlock Text="{Binding DialogTitle}"
                               Style="{StaticResource SectionHeadingStyle}"
                               Foreground="{StaticResource BrandDarkBlueBrush}"
                               Margin="0,0,0,16"/>

                    <Border Background="{StaticResource ErrorSoftBgBrush}"
                            BorderBrush="#FECACA"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="12,9"
                            Margin="0,0,0,14"
                            Visibility="{Binding HasFormError, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Text="{Binding FormErrorMessage}"
                                   Foreground="{StaticResource ErrorRedBrush}"
                                   FontWeight="SemiBold"
                                   FontSize="12.5"
                                   TextWrapping="Wrap"/>
                    </Border>

                    <TextBlock Text="Tên nhà cung cấp *" Style="{StaticResource FormFieldLabelStyle}"/>
                    <TextBox Text="{Binding FormTenNCC, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource FormTextBoxStyle}"
                             Margin="0,0,0,12"/>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="1.25*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                            <TextBlock Text="Số điện thoại *" Style="{StaticResource FormFieldLabelStyle}"/>
                            <TextBox Text="{Binding FormSDT, UpdateSourceTrigger=PropertyChanged}"
                                     MaxLength="11"
                                     Style="{StaticResource FormTextBoxStyle}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                            <TextBlock Text="Email *" Style="{StaticResource FormFieldLabelStyle}"/>
                            <TextBox Text="{Binding FormEmail, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource FormTextBoxStyle}"/>
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="Địa chỉ trụ sở *" Style="{StaticResource FormFieldLabelStyle}"/>
                    <TextBox Text="{Binding FormDiaChi, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource FormTextBoxStyle}"
                             Margin="0,0,0,20"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Hủy bỏ"
                                Command="{Binding CloseSupplierDialogCommand}"
                                Style="{StaticResource SecondaryOutlineButtonStyle}"
                                Padding="18,9"
                                Margin="0,0,10,0"/>
                        <Button Content="Lưu nhà cung cấp"
                                Command="{Binding SaveSupplierCommand}"
                                Style="{StaticResource PrimaryCtaButtonStyle}"
                                Padding="20,9"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Page>
