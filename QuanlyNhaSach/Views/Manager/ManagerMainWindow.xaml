<Window x:Class="QuanlyNhaSach.Views.Manager.ManagerMainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="NHÀ SÁCH NHÓM 1 — Cổng Quản Trị (Manager / Admin Portal)"
        Height="860" Width="1380"
        MinHeight="680" MinWidth="1100"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource SubtleSurfaceBrush}">

    <Grid>
        <Grid.ColumnDefinitions>
            <!-- Persistent Left Administrative Sidebar (#172B4D) -->
            <ColumnDefinition Width="278"/>
            <!-- Right Content Region -->
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ==================== 1. PERSISTENT LEFT SIDEBAR (#172B4D) ==================== -->
        <Border Grid.Column="0"
                Background="{StaticResource StaffSidebarBrush}"
                BorderBrush="#0F1D35"
                BorderThickness="0,0,1,0">
            <Grid Margin="20,24">
                <Grid.RowDefinitions>
                    <!-- Sidebar Header -->
                    <RowDefinition Height="Auto"/>
                    <!-- Navigation Menu (7 required items) -->
                    <RowDefinition Height="*"/>
                    <!-- Sidebar Footer (Avatar, Manager Name, Role, Logout) -->
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- A. Sidebar Header -->
                <StackPanel Grid.Row="0" Margin="4,0,4,24">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="44" Height="44" CornerRadius="12" Background="{StaticResource BrandOrangeBrush}" Margin="0,0,12,0">
                            <Path Data="{StaticResource IconBookGeometry}"
                                  Fill="White"
                                  Width="22" Height="22"
                                  Stretch="Uniform"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="NHÀ SÁCH NHÓM 1"
                                       FontSize="16"
                                       FontWeight="Bold"
                                       Foreground="White"/>
                            <TextBlock Text="CỔNG QUẢN TRỊ"
                                       FontSize="11.5"
                                       FontWeight="Bold"
                                       Foreground="#FDBA74"
                                       Margin="0,2,0,0"/>
                        </StackPanel>
                    </StackPanel>

                    <Border Height="1" Background="#253D6B" Margin="0,18,0,0"/>
                </StackPanel>

                <!-- B. Sidebar Menu (Exact 7 Menu Items in Required Order) -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <TextBlock Text="DANH MỤC QUẢN TRỊ"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   Foreground="#94A3B8"
                                   Margin="8,0,0,10"/>

                        <!-- 1. Tổng quan -->
                        <Button Command="{Binding NavigateOverviewCommand}"
                                Tag="{Binding OverviewTag}"
                                Style="{StaticResource StaffSidebarNavButtonStyle}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="{StaticResource IconDashboardGeometry}"
                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      Width="18" Height="18"
                                      Stretch="Uniform"
                                      Margin="0,0,12,0"
                                      VerticalAlignment="Center"/>
                                <TextBlock Text="Tổng quan"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                           FontWeight="{Binding FontWeight, RelativeSource={RelativeSource AncestorType=Button}}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- 2. Quản lý sách -->
                        <Button Command="{Binding NavigateBookManagementCommand}"
                                Tag="{Binding BookManagementTag}"
                                Style="{StaticResource StaffSidebarNavButtonStyle}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="{StaticResource IconBookGeometry}"
                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      Width="18" Height="18"
                                      Stretch="Uniform"
                                      Margin="0,0,12,0"
                                      VerticalAlignment="Center"/>
                                <TextBlock Text="Quản lý sách"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                           FontWeight="{Binding FontWeight, RelativeSource={RelativeSource AncestorType=Button}}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- 3. Quản lý nhân viên -->
                        <Button Command="{Binding NavigateStaffManagementCommand}"
                                Tag="{Binding StaffManagementTag}"
                                Style="{StaticResource StaffSidebarNavButtonStyle}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="{StaticResource IconStaffGroupGeometry}"
                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      Width="18" Height="18"
                                      Stretch="Uniform"
                                      Margin="0,0,12,0"
                                      VerticalAlignment="Center"/>
                                <TextBlock Text="Quản lý nhân viên"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                           FontWeight="{Binding FontWeight, RelativeSource={RelativeSource AncestorType=Button}}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- 4. Quản lý khách hàng -->
                        <Button Command="{Binding NavigateCustomerManagementCommand}"
                                Tag="{Binding CustomerManagementTag}"
                                Style="{StaticResource StaffSidebarNavButtonStyle}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="{StaticResource IconUserGeometry}"
                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      Width="18" Height="18"
                                      Stretch="Uniform"
                                      Margin="0,0,12,0"
                                      VerticalAlignment="Center"/>
                                <TextBlock Text="Quản lý khách hàng"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                           FontWeight="{Binding FontWeight, RelativeSource={RelativeSource AncestorType=Button}}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- 5. Nhà cung cấp -->
                        <Button Command="{Binding NavigateSupplierManagementCommand}"
                                Tag="{Binding SupplierManagementTag}"
                                Style="{StaticResource StaffSidebarNavButtonStyle}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="{StaticResource IconSupplierGeometry}"
                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      Width="18" Height="18"
                                      Stretch="Uniform"
                                      Margin="0,0,12,0"
                                      VerticalAlignment="Center"/>
                                <TextBlock Text="Nhà cung cấp"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                           FontWeight="{Binding FontWeight, RelativeSource={RelativeSource AncestorType=Button}}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- 6. Nhập hàng -->
                        <Button Command="{Binding NavigateImportReceiptCommand}"
                                Tag="{Binding ImportReceiptTag}"
                                Style="{StaticResource StaffSidebarNavButtonStyle}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="{StaticResource IconImportGeometry}"
                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      Width="18" Height="18"
                                      Stretch="Uniform"
                                      Margin="0,0,12,0"
                                      VerticalAlignment="Center"/>
                                <TextBlock Text="Nhập hàng"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                           FontWeight="{Binding FontWeight, RelativeSource={RelativeSource AncestorType=Button}}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- 7. Lịch sử nhập -->
                        <Button Command="{Binding NavigateImportHistoryCommand}"
                                Tag="{Binding ImportHistoryTag}"
                                Style="{StaticResource StaffSidebarNavButtonStyle}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="{StaticResource IconHistoryGeometry}"
                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      Width="18" Height="18"
                                      Stretch="Uniform"
                                      Margin="0,0,12,0"
                                      VerticalAlignment="Center"/>
                                <TextBlock Text="Lịch sử nhập"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                           FontWeight="{Binding FontWeight, RelativeSource={RelativeSource AncestorType=Button}}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </ScrollViewer>

                <!-- C. Sidebar Footer: Avatar, Authenticated Manager Name, Role & Logout -->
                <StackPanel Grid.Row="2" Margin="0,16,0,0">
                    <Border Height="1" Background="#253D6B" Margin="0,0,0,16"/>

                    <Border Background="#1E3A8A"
                            BorderBrush="#2E51B8"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="14,12"
                            Margin="0,0,0,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Circular Initials Avatar -->
                            <Border Grid.Column="0"
                                    Width="40" Height="40"
                                    CornerRadius="20"
                                    Background="{StaticResource BrandOrangeBrush}"
                                    Margin="0,0,12,0"
                                    VerticalAlignment="Center">
                                <TextBlock Text="{Binding ManagerInitials}"
                                           Foreground="White"
                                           FontWeight="Bold"
                                           FontSize="14"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>

                            <!-- Authenticated Manager Name & Role -->
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding ManagerFullName}"
                                           FontSize="14"
                                           FontWeight="Bold"
                                           Foreground="White"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding ManagerRoleLabel}"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="#FDBA74"
                                           Margin="0,2,0,0"/>
                                <TextBlock Text="{Binding ManagerUsername}"
                                           FontSize="10.5"
                                           Foreground="#93C5FD"
                                           TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Logout Button -->
                    <Button Command="{Binding LogoutCommand}"
                            Style="{StaticResource PrimaryCtaButtonStyle}"
                            Background="#DC2626"
                            Padding="14,11"
                            HorizontalAlignment="Stretch">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Path Data="{StaticResource IconLogoutGeometry}"
                                  Fill="White"
                                  Width="16" Height="16"
                                  Stretch="Uniform"
                                  Margin="0,0,8,0"
                                  VerticalAlignment="Center"/>
                            <TextBlock Text="ĐĂNG XUẤT"
                                       Foreground="White"
                                       FontWeight="Bold"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ==================== 2. RIGHT CONTENT REGION ==================== -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <!-- Top Administrative Bar -->
                <RowDefinition Height="Auto"/>
                <!-- Dynamic Content Frame -->
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Top Header Bar -->
            <Border Grid.Row="0"
                    Background="White"
                    BorderBrush="{StaticResource BorderSubtleBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="32,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding CurrentPageTitle}"
                                   FontSize="19"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource BrandDarkBlueBrush}"/>
                        <TextBlock Text="{Binding CurrentPageSubtitle}"
                                   FontSize="12.5"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   Margin="0,2,0,0"/>
                    </StackPanel>

                    <Border Grid.Column="1"
                            Background="{StaticResource BrandDarkBlueLightBrush}"
                            BorderBrush="#BFDBFE"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="12,6"
                            VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Quản trị viên: "
                                       FontSize="12.5"
                                       Foreground="{StaticResource MutedTextBrush}"/>
                            <TextBlock Text="{Binding ManagerFullName}"
                                       FontSize="12.5"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource BrandDarkBlueBrush}"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- Content Frame -->
            <Frame x:Name="ManagerContentFrame"
                   Grid.Row="1"
                   NavigationUIVisibility="Hidden"/>
        </Grid>
    </Grid>
</Window>
