<Page x:Class="QuanlyNhaSach.Views.Manager.BookManagementPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d"
      Title="Quản lý sách — Cổng Quản Trị"
      Background="{StaticResource SubtleSurfaceBrush}">

    <Grid>
        <!-- ==================== 1. MAIN PAGE CONTENT ==================== -->
        <Grid Margin="32,26">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- A. Header & Primary CTA (+ Thêm sách mới) -->
            <Grid Grid.Row="0" Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Quản lý sách"
                               Style="{StaticResource PageTitleStyle}"/>
                    <TextBlock Text="Quản lý danh mục đầu sách, cập nhật giá bán, theo dõi cảnh báo tồn kho thấp (&lt; 10) và ngừng bán an toàn (UC09)."
                               FontSize="13.5"
                               Foreground="{StaticResource MutedTextBrush}"
                               Margin="0,4,0,0"/>
                </StackPanel>

                <Button Grid.Column="1"
                        Content="+ Thêm sách mới"
                        Command="{Binding OpenAddBookDialogCommand}"
                        Style="{StaticResource PrimaryCtaButtonStyle}"
                        Padding="18,11"
                        VerticalAlignment="Center"/>
            </Grid>

            <!-- B. Search & Stock Filter Toolbar -->
            <Border Grid.Row="1"
                    Style="{StaticResource CardPanelStyle}"
                    Padding="18,14"
                    Margin="0,0,0,18">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2.2*"/>
                        <ColumnDefinition Width="1.2*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Search Box -->
                    <StackPanel Grid.Column="0" Margin="0,0,14,0">
                        <TextBlock Text="Tìm kiếm sách (Mã sách, Tên sách, Tác giả)"
                                   Style="{StaticResource FormFieldLabelStyle}"/>
                        <TextBox Text="{Binding SearchKeyword, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource FormTextBoxStyle}"/>
                    </StackPanel>

                    <!-- Stock Filter -->
                    <StackPanel Grid.Column="1" Margin="0,0,14,0">
                        <TextBlock Text="Lọc trạng thái tồn kho"
                                   Style="{StaticResource FormFieldLabelStyle}"/>
                        <ComboBox ItemsSource="{Binding StockFilterOptions}"
                                  SelectedItem="{Binding SelectedStockFilter}"
                                  Style="{StaticResource FormComboBoxStyle}"/>
                    </StackPanel>

                    <!-- Reset Filter Button -->
                    <Button Grid.Column="2"
                            Content="Đặt lại bộ lọc"
                            Command="{Binding ClearFiltersCommand}"
                            Style="{StaticResource SecondaryOutlineButtonStyle}"
                            VerticalAlignment="Bottom"
                            Margin="0,0,14,0"
                            Padding="14,9"/>

                    <!-- Summary Pill -->
                    <Border Grid.Column="3"
                            Background="{StaticResource ErrorSoftBgBrush}"
                            BorderBrush="#FECACA"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="12,8"
                            VerticalAlignment="Bottom">
                        <TextBlock Text="{Binding LowStockCount, StringFormat='Cảnh báo tồn &lt; 10: {0} sách'}"
                                   FontSize="12.5"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource ErrorRedBrush}"/>
                    </Border>
                </Grid>
            </Border>

            <!-- C. Books DataGrid -->
            <Border Grid.Row="2" Style="{StaticResource CardPanelStyle}" Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="{Binding TotalDisplayedCount, StringFormat='Danh mục hiển thị: {0} đầu sách'}"
                               FontSize="13"
                               FontWeight="Bold"
                               Foreground="{StaticResource CharcoalTextBrush}"
                               Margin="4,0,0,10"/>

                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding DisplayedBooks}"
                              Style="{StaticResource AdminDataGridStyle}">
                        <DataGrid.Columns>

                            <!-- 1. Book Cover Placeholder -->
                            <DataGridTemplateColumn Header="Ảnh bìa" Width="80">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Width="42" Height="54"
                                                CornerRadius="6"
                                                Background="{Binding MauBia, Converter={StaticResource StringToBrushConverter}}"
                                                HorizontalAlignment="Left">
                                            <TextBlock Text="{Binding CoverInitials}"
                                                       Foreground="White"
                                                       FontWeight="Bold"
                                                       FontSize="13"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- 2. Book ID -->
                            <DataGridTextColumn Header="Mã sách" Binding="{Binding BookCode}" Width="90"/>

                            <!-- 3. Book Title -->
                            <DataGridTemplateColumn Header="Tên đầu sách" Width="2.2*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel>
                                            <TextBlock Text="{Binding TenSach}"
                                                       FontWeight="Bold"
                                                       FontSize="13.5"
                                                       Foreground="{StaticResource CharcoalTextBrush}"
                                                       TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding TheLoai}"
                                                       FontSize="11.5"
                                                       Foreground="{StaticResource MutedTextBrush}"
                                                       Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- 4. Author -->
                            <DataGridTextColumn Header="Tác giả" Binding="{Binding TacGia}" Width="1.3*"/>

                            <!-- 5. Selling Price -->
                            <DataGridTemplateColumn Header="Giá bán" Width="130">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding FormattedPrice}"
                                                   FontWeight="Bold"
                                                   Foreground="{StaticResource BrandOrangeBrush}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- 6. Current Stock -->
                            <DataGridTemplateColumn Header="Tồn kho" Width="95">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding SoLuongTon}"
                                                   FontWeight="Bold"
                                                   FontSize="13.5"
                                                   Foreground="{StaticResource CharcoalTextBrush}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- 7. Stock Status Badge (SoLuongTon < 10 => Red Sắp hết / 0 => Hết hàng) -->
                            <DataGridTemplateColumn Header="Trạng thái tồn" Width="135">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="6"
                                                Padding="10,4"
                                                HorizontalAlignment="Left"
                                                Background="{Binding SoLuongTon, Converter={StaticResource StockBadgeBackgroundConverter}}">
                                            <TextBlock Text="{Binding AdminStockStatusText}"
                                                       FontSize="12"
                                                       FontWeight="Bold"
                                                       Foreground="{Binding SoLuongTon, Converter={StaticResource StockBadgeForegroundConverter}}"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- 8. Actions -->
                            <DataGridTemplateColumn Header="Thao tác" Width="195">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="Sửa"
                                                    Command="{Binding DataContext.OpenEditBookDialogCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource SecondaryOutlineButtonStyle}"
                                                    Padding="12,5"
                                                    Margin="0,0,8,0"/>
                                            <Button Content="Xóa / Ngừng"
                                                    Command="{Binding DataContext.DeleteBookCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource RemoveItemButtonStyle}"
                                                    Padding="10,5"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>

        <!-- ==================== 2. REUSABLE ADD / EDIT BOOK MODAL DIALOG ==================== -->
        <Grid Background="#7F0F172A"
              Visibility="{Binding IsBookDialogOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Border Width="560"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Style="{StaticResource CardPanelStyle}"
                    Padding="28,24">
                <StackPanel>
                    <TextBlock Text="{Binding DialogTitle}"
                               Style="{StaticResource SectionHeadingStyle}"
                               Foreground="{StaticResource BrandDarkBlueBrush}"
                               Margin="0,0,0,16"/>

                    <!-- Validation Error Banner -->
                    <Border Background="{StaticResource ErrorSoftBgBrush}"
                            BorderBrush="#FECACA"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="12,9"
                            Margin="0,0,0,14"
                            Visibility="{Binding HasFormError, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Text="{Binding FormErrorMessage}"
                                   Foreground="{StaticResource ErrorRedBrush}"
                                   FontWeight="SemiBold"
                                   FontSize="12.5"
                                   TextWrapping="Wrap"/>
                    </Border>

                    <!-- Book Title -->
                    <TextBlock Text="Tên sách *" Style="{StaticResource FormFieldLabelStyle}"/>
                    <TextBox Text="{Binding FormTenSach, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource FormTextBoxStyle}"
                             Margin="0,0,0,12"/>

                    <!-- Author & Category -->
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                            <TextBlock Text="Tác giả *" Style="{StaticResource FormFieldLabelStyle}"/>
                            <TextBox Text="{Binding FormTacGia, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource FormTextBoxStyle}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                            <TextBlock Text="Thể loại" Style="{StaticResource FormFieldLabelStyle}"/>
                            <TextBox Text="{Binding FormTheLoai, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource FormTextBoxStyle}"/>
                        </StackPanel>
                    </Grid>

                    <!-- Selling Price & Stock -->
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                            <TextBlock Text="Giá bán (VND > 0) *" Style="{StaticResource FormFieldLabelStyle}"/>
                            <TextBox Text="{Binding FormGiaBanText, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource FormTextBoxStyle}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                            <TextBlock Text="Số lượng tồn kho (>= 0) *" Style="{StaticResource FormFieldLabelStyle}"/>
                            <TextBox Text="{Binding FormSoLuongTonText, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource FormTextBoxStyle}"/>
                        </StackPanel>
                    </Grid>

                    <!-- Cover Color & Cover Placeholder -->
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                            <TextBlock Text="Màu bìa hiển thị" Style="{StaticResource FormFieldLabelStyle}"/>
                            <ComboBox ItemsSource="{Binding CoverColorPresets}"
                                      SelectedItem="{Binding FormMauBia}"
                                      Style="{StaticResource FormComboBoxStyle}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                            <TextBlock Text="Mã ảnh bìa / Placeholder" Style="{StaticResource FormFieldLabelStyle}"/>
                            <TextBox Text="{Binding FormAnhBia, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource FormTextBoxStyle}"/>
                        </StackPanel>
                    </Grid>

                    <!-- Description -->
                    <TextBlock Text="Mô tả nội dung sách" Style="{StaticResource FormFieldLabelStyle}"/>
                    <TextBox Text="{Binding FormMoTa, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource FormTextBoxStyle}"
                             Height="64"
                             TextWrapping="Wrap"
                             AcceptsReturn="True"
                             Margin="0,0,0,18"/>

                    <!-- Dialog Actions -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Hủy bỏ"
                                Command="{Binding CloseBookDialogCommand}"
                                Style="{StaticResource SecondaryOutlineButtonStyle}"
                                Padding="18,9"
                                Margin="0,0,10,0"/>
                        <Button Content="Lưu thông tin sách"
                                Command="{Binding SaveBookCommand}"
                                Style="{StaticResource PrimaryCtaButtonStyle}"
                                Padding="20,9"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Page>
