<Page x:Class="QuanlyNhaSach.Views.Manager.StaffManagementPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:conv="clr-namespace:QuanlyNhaSach.Converters"
      mc:Ignorable="d"
      Title="Quản lý nhân viên — Cổng Quản Trị"
      Background="{StaticResource SubtleSurfaceBrush}">

    <Grid>
        <!-- ==================== 1. MAIN PAGE CONTENT ==================== -->
        <Grid Margin="32,26">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- A. Header & Primary CTA (+ Thêm nhân viên) -->
            <Grid Grid.Row="0" Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Quản lý nhân viên"
                               Style="{StaticResource PageTitleStyle}"/>
                    <TextBlock Text="Quản lý danh sách nhân viên nhà sách, cấp tài khoản mới và kiểm soát trạng thái Hoạt động / Đã khóa (UC02)."
                               FontSize="13.5"
                               Foreground="{StaticResource MutedTextBrush}"
                               Margin="0,4,0,0"/>
                </StackPanel>

                <Button Grid.Column="1"
                        Content="+ Thêm nhân viên"
                        Command="{Binding OpenAddStaffDialogCommand}"
                        Style="{StaticResource PrimaryCtaButtonStyle}"
                        Padding="18,11"
                        VerticalAlignment="Center"/>
            </Grid>

            <!-- B. Search & Status Filter Toolbar -->
            <Border Grid.Row="1"
                    Style="{StaticResource CardPanelStyle}"
                    Padding="18,14"
                    Margin="0,0,0,18">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2.2*"/>
                        <ColumnDefinition Width="1.1*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,14,0">
                        <TextBlock Text="Tìm kiếm nhân viên (Mã NV, Họ tên, Tên đăng nhập, Số điện thoại)"
                                   Style="{StaticResource FormFieldLabelStyle}"/>
                        <TextBox Text="{Binding SearchKeyword, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource FormTextBoxStyle}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="0,0,14,0">
                        <TextBlock Text="Trạng thái tài khoản"
                                   Style="{StaticResource FormFieldLabelStyle}"/>
                        <ComboBox ItemsSource="{Binding StatusFilterOptions}"
                                  SelectedItem="{Binding SelectedStatusFilter}"
                                  Style="{StaticResource FormComboBoxStyle}"/>
                    </StackPanel>

                    <Button Grid.Column="2"
                            Content="Đặt lại"
                            Command="{Binding ClearFiltersCommand}"
                            Style="{StaticResource SecondaryOutlineButtonStyle}"
                            VerticalAlignment="Bottom"
                            Margin="0,0,14,0"
                            Padding="14,9"/>

                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Bottom">
                        <Border Background="{StaticResource SuccessSoftBgBrush}" CornerRadius="8" Padding="10,8" Margin="0,0,8,0">
                            <TextBlock Text="{Binding ActiveStaffCount, StringFormat='Hoạt động: {0}'}"
                                       FontSize="12"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource SuccessGreenBrush}"/>
                        </Border>
                        <Border Background="{StaticResource ErrorSoftBgBrush}" CornerRadius="8" Padding="10,8">
                            <TextBlock Text="{Binding LockedStaffCount, StringFormat='Đã khóa: {0}'}"
                                       FontSize="12"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource ErrorRedBrush}"/>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- C. Staff DataGrid -->
            <Border Grid.Row="2" Style="{StaticResource CardPanelStyle}" Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="{Binding TotalDisplayedCount, StringFormat='Danh sách hiển thị: {0} nhân viên'}"
                               FontSize="13"
                               FontWeight="Bold"
                               Foreground="{StaticResource CharcoalTextBrush}"
                               Margin="4,0,0,10"/>

                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding DisplayedStaff}"
                              Style="{StaticResource AdminDataGridStyle}">
                        <DataGrid.Columns>
                            <!-- 1. Staff ID -->
                            <DataGridTextColumn Header="Mã NV" Binding="{Binding UserCode}" Width="90"/>

                            <!-- 2. Full Name -->
                            <DataGridTemplateColumn Header="Họ và tên nhân viên" Width="1.5*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding HoTen}"
                                                   FontWeight="Bold"
                                                   Foreground="{StaticResource CharcoalTextBrush}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- 3. Username -->
                            <DataGridTextColumn Header="Tên đăng nhập" Binding="{Binding Username}" Width="1.5*"/>

                            <!-- 4. Phone Number -->
                            <DataGridTextColumn Header="Số điện thoại" Binding="{Binding SDT}" Width="125"/>

                            <!-- 5. Address -->
                            <DataGridTextColumn Header="Địa chỉ" Binding="{Binding DiaChi}" Width="1.8*"/>

                            <!-- 6. Account Status -->
                            <DataGridTemplateColumn Header="Trạng thái" Width="130">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="6"
                                                Padding="10,4"
                                                HorizontalAlignment="Left"
                                                Background="{Binding IsActive, Converter={StaticResource AccountStatusBadgeBackgroundConverter}}">
                                            <TextBlock Text="{Binding AccountStatusLabel}"
                                                       FontSize="12"
                                                       FontWeight="Bold"
                                                       Foreground="{Binding IsActive, Converter={StaticResource AccountStatusBadgeForegroundConverter}}"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- 7. Actions -->
                            <DataGridTemplateColumn Header="Thao tác" Width="165">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="{Binding ToggleLockActionText}"
                                                Command="{Binding DataContext.ToggleStaffLockCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource SecondaryOutlineButtonStyle}"
                                                Padding="12,5"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>

        <!-- ==================== 2. ADD STAFF MODAL DIALOG ==================== -->
        <Grid Background="#7F0F172A"
              Visibility="{Binding IsAddStaffDialogOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Border Width="540"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Style="{StaticResource CardPanelStyle}"
                    Padding="28,24">
                <StackPanel>
                    <TextBlock Text="Thêm tài khoản nhân viên mới (UC02)"
                               Style="{StaticResource SectionHeadingStyle}"
                               Foreground="{StaticResource BrandDarkBlueBrush}"
                               Margin="0,0,0,6"/>
                    <TextBlock Text="Tài khoản được tạo mới tự động gán vai trò Nhân viên (Staff) và trạng thái Hoạt động."
                               FontSize="12.5"
                               Foreground="{StaticResource MutedTextBrush}"
                               Margin="0,0,0,16"/>

                    <Border Background="{StaticResource ErrorSoftBgBrush}"
                            BorderBrush="#FECACA"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="12,9"
                            Margin="0,0,0,14"
                            Visibility="{Binding HasFormError, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Text="{Binding FormErrorMessage}"
                                   Foreground="{StaticResource ErrorRedBrush}"
                                   FontWeight="SemiBold"
                                   FontSize="12.5"
                                   TextWrapping="Wrap"/>
                    </Border>

                    <TextBlock Text="Họ và tên nhân viên *" Style="{StaticResource FormFieldLabelStyle}"/>
                    <TextBox Text="{Binding FormHoTen, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource FormTextBoxStyle}"
                             Margin="0,0,0,12"/>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="1.2*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                            <TextBlock Text="Số điện thoại (10 chữ số) *" Style="{StaticResource FormFieldLabelStyle}"/>
                            <TextBox Text="{Binding FormSDT, UpdateSourceTrigger=PropertyChanged}"
                                     MaxLength="10"
                                     Style="{StaticResource FormTextBoxStyle}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                            <TextBlock Text="Tên đăng nhập / Email *" Style="{StaticResource FormFieldLabelStyle}"/>
                            <TextBox Text="{Binding FormUsername, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource FormTextBoxStyle}"/>
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="Địa chỉ liên hệ *" Style="{StaticResource FormFieldLabelStyle}"/>
                    <TextBox Text="{Binding FormDiaChi, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource FormTextBoxStyle}"
                             Margin="0,0,0,12"/>

                    <Grid Margin="0,0,0,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                            <TextBlock Text="Mật khẩu khởi tạo (>= 6 ký tự) *" Style="{StaticResource FormFieldLabelStyle}"/>
                            <PasswordBox Style="{StaticResource FormPasswordBoxStyle}"
                                         conv:PasswordBoxHelper.BoundPassword="{Binding FormPassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                            <TextBlock Text="Xác nhận mật khẩu *" Style="{StaticResource FormFieldLabelStyle}"/>
                            <PasswordBox Style="{StaticResource FormPasswordBoxStyle}"
                                         conv:PasswordBoxHelper.BoundPassword="{Binding FormConfirmPassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                    </Grid>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Hủy bỏ"
                                Command="{Binding CloseAddStaffDialogCommand}"
                                Style="{StaticResource SecondaryOutlineButtonStyle}"
                                Padding="18,9"
                                Margin="0,0,10,0"/>
                        <Button Content="Tạo tài khoản nhân viên"
                                Command="{Binding SaveNewStaffCommand}"
                                Style="{StaticResource PrimaryCtaButtonStyle}"
                                Padding="20,9"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Page>
