<Page x:Class="QuanlyNhaSach.Views.Customer.HomePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      mc:Ignorable="d"
      d:DesignHeight="760" d:DesignWidth="1180"
      Title="HomePage"
      Background="{StaticResource MainBackgroundBrush}">

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="36,28,36,40">

                <!-- A. HERO BANNER (#1E3A8A) -->
                <Border Background="{StaticResource BrandDarkBlueBrush}"
                        CornerRadius="16"
                        Padding="36,30"
                        Margin="0,0,0,28"
                        Effect="{StaticResource CardShadowEffect}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Welcome Heading & Copy -->
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <Border Background="#2B4C9E" CornerRadius="16" Padding="12,4" HorizontalAlignment="Left" Margin="0,0,0,12">
                                <TextBlock Text="BOOKNEST — CỬA HÀNG SÁCH TRỰC TUYẾN"
                                           Foreground="#93C5FD"
                                           FontSize="11.5"
                                           FontWeight="Bold"/>
                            </Border>

                            <TextBlock Text="Khám phá thế giới tri thức"
                                       FontSize="30"
                                       FontWeight="Bold"
                                       Foreground="White"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,8"/>

                            <TextBlock Text="Tìm cuốn sách tiếp theo dành riêng cho bạn."
                                       FontSize="15.5"
                                       Foreground="#DBEAFE"
                                       TextWrapping="Wrap"/>
                        </StackPanel>

                        <!-- Decorative XAML Book Illustration -->
                        <Border Grid.Column="1"
                                Background="#172E6E"
                                CornerRadius="14"
                                Padding="22,16"
                                Margin="24,0,0,0"
                                VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Width="48" Height="64" Background="{StaticResource BrandOrangeBrush}" CornerRadius="6" Margin="0,0,12,0">
                                    <Path Data="{StaticResource IconBookGeometry}"
                                          Fill="White"
                                          Width="24" Height="24"
                                          Stretch="Uniform"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Tủ Sách Tinh Hoa" Foreground="White" FontWeight="Bold" FontSize="14"/>
                                    <TextBlock Text="100% Dữ liệu In-Memory" Foreground="#93C5FD" FontSize="12" Margin="0,3,0,0"/>
                                    <TextBlock Text="Cập nhật tồn kho tức thì" Foreground="#BFDBFE" FontSize="11.5" Margin="0,2,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- B. SECTION HEADING, FILTER & SORT CONTROLS -->
                <Grid Margin="0,0,0,22">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left Side: Title "Khám phá sách", Subtitle, and Active Filter Badges -->
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Khám phá sách" Style="{StaticResource SectionHeadingStyle}" FontSize="20" VerticalAlignment="Center"/>
                            <Border Background="{StaticResource BrandDarkBlueLightBrush}" CornerRadius="12" Padding="10,3" Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding TotalCount, StringFormat='{}{0} đầu sách'}"
                                           Foreground="{StaticResource BrandDarkBlueBrush}"
                                           FontWeight="SemiBold"
                                           FontSize="12.5"/>
                            </Border>

                            <!-- Active Search Filter Tag -->
                            <Border Background="{StaticResource BrandOrangeLightBrush}"
                                    BorderBrush="{StaticResource BrandOrangeBrush}"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    Padding="10,3"
                                    Margin="10,0,0,0"
                                    VerticalAlignment="Center"
                                    Visibility="{Binding IsSearchFiltered, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock Text="{Binding ActiveKeyword, StringFormat='Từ khóa: &quot;{0}&quot;'}"
                                           Foreground="{StaticResource BrandOrangeBrush}"
                                           FontWeight="SemiBold"
                                           FontSize="12.5"/>
                            </Border>
                        </StackPanel>

                        <TextBlock Text="Lựa chọn những tựa sách yêu thích đang có mặt tại cửa hàng."
                                   FontSize="13.5"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   Margin="0,4,0,0"/>
                    </StackPanel>

                    <!-- Right Side: Stock Filter & Sort Dropdowns -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Filter ComboBox -->
                        <ComboBox Width="155"
                                  ItemsSource="{Binding StockFilterOptions}"
                                  SelectedItem="{Binding SelectedStockFilter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  Style="{StaticResource FormComboBoxStyle}"/>

                        <!-- Sort ComboBox -->
                        <ComboBox Width="170"
                                  Margin="10,0,0,0"
                                  ItemsSource="{Binding SortOptions}"
                                  SelectedItem="{Binding SelectedSortOption, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  Style="{StaticResource FormComboBoxStyle}"/>

                        <!-- Reset Search / Filters Button -->
                        <Button Content="✕ Đặt lại"
                                Command="{Binding ResetSearchCommand}"
                                Style="{StaticResource SecondaryOutlineButtonStyle}"
                                Margin="10,0,0,0"
                                Padding="12,7"
                                Visibility="{Binding IsSearchFiltered, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    </StackPanel>
                </Grid>

                <!-- C. BOOK CATALOG CARDS -->
                <ItemsControl ItemsSource="{Binding DisplayedBooks}"
                              ItemTemplate="{StaticResource BookCatalogCardTemplate}"
                              Visibility="{Binding HasBooks, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>

                <!-- D. FRIENDLY EMPTY RESULTS STATE -->
                <Border Style="{StaticResource CardPanelStyle}"
                        Padding="48,40"
                        Margin="0,12,0,0"
                        Visibility="{Binding IsEmptyResult, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel HorizontalAlignment="Center" MaxWidth="460">
                        <Path Data="{StaticResource IconSearchGeometry}"
                              Fill="{StaticResource BrandDarkBlueBrush}"
                              Width="42" Height="42"
                              Stretch="Uniform"
                              HorizontalAlignment="Center"
                              Margin="0,0,0,14"/>
                        <TextBlock Text="Không tìm thấy sách phù hợp"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource BrandDarkBlueBrush}"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,8"/>
                        <TextBlock Text="{Binding EmptyStateMessage}"
                                   FontSize="14"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,20"/>
                        <Button Content="Xem toàn bộ danh mục sách"
                                Command="{Binding ResetSearchCommand}"
                                Style="{StaticResource PrimaryCtaButtonStyle}"
                                HorizontalAlignment="Center"
                                Padding="20,10"/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- Toast Feedback Banner -->
        <Border Background="{StaticResource BrandDarkBlueBrush}"
                CornerRadius="10"
                Padding="18,12"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Margin="0,0,32,28"
                Effect="{StaticResource ElevatedShadowEffect}"
                Visibility="{Binding IsStatusBannerVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="✓" Foreground="#4ADE80" FontWeight="Bold" FontSize="15" Margin="0,0,10,0" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding StatusBannerMessage}" Foreground="White" FontWeight="SemiBold" FontSize="13.5" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</Page>
