<Page x:Class="QuanlyNhaSach.Views.Customer.CartCheckoutPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      mc:Ignorable="d"
      d:DesignHeight="820" d:DesignWidth="1180"
      Title="CartCheckoutPage"
      Background="{StaticResource MainBackgroundBrush}">

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="36,28,36,40">

                <!-- Page Header & Actions -->
                <Grid Margin="0,0,0,22">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Giỏ Hàng &amp; Thanh Toán Đơn Hàng" Style="{StaticResource PageTitleStyle}"/>
                        <TextBlock Text="Kiểm tra danh sách sách đã chọn và nhập thông tin nhận hàng để hoàn tất đặt hàng."
                                   FontSize="14"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   Margin="0,4,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="← Tiếp tục mua sắm"
                                Command="{Binding ContinueShoppingCommand}"
                                Style="{StaticResource SecondaryOutlineButtonStyle}"
                                Margin="0,0,10,0"/>

                        <Button Content="Xóa toàn bộ giỏ"
                                Command="{Binding ClearCartCommand}"
                                Style="{StaticResource RemoveItemButtonStyle}"
                                Padding="14,8"
                                Visibility="{Binding HasCartItems, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    </StackPanel>
                </Grid>

                <!-- POST-CHECKOUT ORDER SUCCESS BANNER -->
                <Border Background="{StaticResource SuccessSoftBgBrush}"
                        BorderBrush="#6EE7B7"
                        BorderThickness="1.5"
                        CornerRadius="12"
                        Padding="24,20"
                        Margin="0,0,0,24"
                        Visibility="{Binding HasLastCreatedOrder, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Width="48" Height="48" CornerRadius="24" Background="#10B981" Margin="0,0,18,0" VerticalAlignment="Center">
                            <TextBlock Text="✓" Foreground="White" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding LastOrderBannerTitle}"
                                       FontSize="17"
                                       FontWeight="Bold"
                                       Foreground="#065F46"/>
                            <WrapPanel Orientation="Horizontal" Margin="0,4,0,4">
                                <TextBlock Text="{Binding LastCreatedOrder.HoTenKhachHang, StringFormat='Khách hàng: {0}  |  '}" FontSize="13.5" Foreground="#047857" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding LastCreatedOrder.PhuongThucThanhToan, StringFormat='Thanh toán: {0}  |  '}" FontSize="13.5" Foreground="#047857" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding LastCreatedOrder.TrangThaiThanhToan, StringFormat='TT Thanh toán: {0}  |  '}" FontSize="13.5" Foreground="#065F46" FontWeight="Bold"/>
                                <TextBlock Text="{Binding LastCreatedOrder.FormattedTongTien, StringFormat='Tổng tiền: {0}  |  '}" FontSize="13.5" Foreground="#065F46" FontWeight="Bold"/>
                                <TextBlock Text="{Binding LastCreatedOrder.TrangThai, StringFormat='Trạng thái ĐH: {0}'}" FontSize="13.5" Foreground="#047857" FontWeight="SemiBold"/>
                            </WrapPanel>
                            <TextBlock Text="{Binding LastOrderBannerSubtitle}"
                                       FontSize="12"
                                       Foreground="#047857"/>
                        </StackPanel>

                        <Button Grid.Column="2"
                                Content="Mua thêm sách mới"
                                Command="{Binding ContinueShoppingCommand}"
                                Style="{StaticResource PrimaryCtaButtonStyle}"
                                VerticalAlignment="Center"
                                Margin="16,0,0,0"/>
                    </Grid>
                </Border>

                <!-- TWO-COLUMN CART & CHECKOUT LAYOUT -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.35*"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>

                    <!-- LEFT COLUMN: A. SHOPPING CART PANEL -->
                    <StackPanel Grid.Column="0" Margin="0,0,24,0">

                        <!-- Active Cart Items Card -->
                        <Border Style="{StaticResource CardPanelStyle}"
                                Padding="24"
                                Visibility="{Binding HasCartItems, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <StackPanel>
                                <Grid Margin="0,0,0,16">
                                    <TextBlock Text="Danh Sách Sản Phẩm Trong Giỏ" Style="{StaticResource SectionHeadingStyle}"/>
                                    <Border Background="{StaticResource BrandDarkBlueLightBrush}" CornerRadius="10" Padding="10,3" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding TotalQuantity, StringFormat='{}{0} cuốn sách'}"
                                                   Foreground="{StaticResource BrandDarkBlueBrush}"
                                                   FontWeight="Bold"
                                                   FontSize="12.5"/>
                                    </Border>
                                </Grid>

                                <!-- Table Column Headers -->
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="56"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="105"/>
                                        <ColumnDefinition Width="118"/>
                                        <ColumnDefinition Width="115"/>
                                        <ColumnDefinition Width="64"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" Text="Bìa" FontSize="12" FontWeight="Bold" Foreground="{StaticResource MutedTextBrush}"/>
                                    <TextBlock Grid.Column="1" Text="Thông tin sách" FontSize="12" FontWeight="Bold" Foreground="{StaticResource MutedTextBrush}" Margin="10,0,0,0"/>
                                    <TextBlock Grid.Column="2" Text="Đơn giá" FontSize="12" FontWeight="Bold" Foreground="{StaticResource MutedTextBrush}" TextAlignment="Right"/>
                                    <TextBlock Grid.Column="3" Text="Số lượng" FontSize="12" FontWeight="Bold" Foreground="{StaticResource MutedTextBrush}" TextAlignment="Center"/>
                                    <TextBlock Grid.Column="4" Text="Thành tiền" FontSize="12" FontWeight="Bold" Foreground="{StaticResource MutedTextBrush}" TextAlignment="Right"/>
                                    <TextBlock Grid.Column="5" Text="Thao tác" FontSize="12" FontWeight="Bold" Foreground="{StaticResource MutedTextBrush}" TextAlignment="Right"/>
                                </Grid>

                                <Separator Background="{StaticResource BorderSubtleBrush}" Margin="0,0,0,8"/>

                                <!-- Cart Items List -->
                                <ItemsControl ItemsSource="{Binding CartItems}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="{StaticResource BorderSubtleBrush}"
                                                    BorderThickness="0,0,0,1"
                                                    Padding="0,14">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="56"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="105"/>
                                                        <ColumnDefinition Width="118"/>
                                                        <ColumnDefinition Width="115"/>
                                                        <ColumnDefinition Width="64"/>
                                                    </Grid.ColumnDefinitions>

                                                    <!-- Small Cover Thumbnail or Placeholder -->
                                                    <Border Grid.Column="0"
                                                            Width="48"
                                                            Height="64"
                                                            CornerRadius="6"
                                                            Background="{Binding Book.MauBia, Converter={StaticResource StringToBrushConverter}}"
                                                            ClipToBounds="True">
                                                        <Grid>
                                                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                                                        Visibility="{Binding Book.HasImage, Converter={StaticResource BooleanToInverseVisibilityConverter}}">
                                                                <Path Data="{StaticResource IconBookGeometry}"
                                                                      Fill="White"
                                                                      Width="16" Height="16"
                                                                      Stretch="Uniform"
                                                                      HorizontalAlignment="Center"
                                                                      Margin="0,0,0,2"/>
                                                                <TextBlock Text="{Binding Book.MaSach, StringFormat='#{0}'}"
                                                                           Foreground="White"
                                                                           FontSize="9.5"
                                                                           FontWeight="Bold"
                                                                           HorizontalAlignment="Center"/>
                                                            </StackPanel>
                                                            <Image Source="{Binding Book.DisplayHinhAnh}"
                                                                   Stretch="UniformToFill"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center"
                                                                   Visibility="{Binding Book.HasImage, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                        </Grid>
                                                    </Border>

                                                    <!-- Book Title, Author & Stock Indicator -->
                                                    <StackPanel Grid.Column="1" Margin="10,0,10,0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Book.Tensach}"
                                                                   FontWeight="Bold"
                                                                   FontSize="14"
                                                                   Foreground="{StaticResource CharcoalTextBrush}"
                                                                   TextWrapping="Wrap"/>
                                                        <TextBlock Text="{Binding Book.Tacgia, StringFormat='Tác giả: {0}'}"
                                                                   FontSize="12"
                                                                   Foreground="{StaticResource MutedTextBrush}"
                                                                   Margin="0,2,0,4"/>
                                                        <Border HorizontalAlignment="Left"
                                                                CornerRadius="4"
                                                                Padding="6,2"
                                                                Background="{Binding Book.Soluongton, Converter={StaticResource StockBadgeBackgroundConverter}}">
                                                            <TextBlock Text="{Binding Book.StockStatusText}"
                                                                       FontSize="11"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="{Binding Book.Soluongton, Converter={StaticResource StockBadgeForegroundConverter}}"/>
                                                        </Border>
                                                    </StackPanel>

                                                    <!-- Unit Price -->
                                                    <TextBlock Grid.Column="2"
                                                               Text="{Binding Book.FormattedPrice}"
                                                               VerticalAlignment="Center"
                                                               TextAlignment="Right"
                                                               FontWeight="SemiBold"
                                                               FontSize="13.5"/>

                                                    <!-- Quantity Controls (- / Quantity / +) -->
                                                    <Border Grid.Column="3"
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center"
                                                            BorderBrush="{StaticResource BorderSubtleBrush}"
                                                            BorderThickness="1"
                                                            CornerRadius="6"
                                                            Padding="2"
                                                            Background="White">
                                                        <StackPanel Orientation="Horizontal">
                                                            <Button Content="−"
                                                                    Style="{StaticResource QuantityStepperButtonStyle}"
                                                                    Width="26" Height="26"
                                                                    Command="{Binding DataContext.DecreaseQuantityCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                                    CommandParameter="{Binding}"/>

                                                            <TextBlock Text="{Binding SoLuongMua}"
                                                                       Width="34"
                                                                       TextAlignment="Center"
                                                                       VerticalAlignment="Center"
                                                                       FontWeight="Bold"
                                                                       FontSize="13.5"/>

                                                            <Button Content="+"
                                                                    Style="{StaticResource QuantityStepperButtonStyle}"
                                                                    Width="26" Height="26"
                                                                    Command="{Binding DataContext.IncreaseQuantityCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                                    CommandParameter="{Binding}"/>
                                                        </StackPanel>
                                                    </Border>

                                                    <!-- Line Total (ThanhTien) -->
                                                    <TextBlock Grid.Column="4"
                                                               Text="{Binding FormattedThanhTien}"
                                                               VerticalAlignment="Center"
                                                               TextAlignment="Right"
                                                               FontWeight="Bold"
                                                               FontSize="14"
                                                               Foreground="{StaticResource BrandOrangeBrush}"/>

                                                    <!-- Explicit Remove Button -->
                                                    <Button Grid.Column="5"
                                                            Content="Xóa"
                                                            Style="{StaticResource RemoveItemButtonStyle}"
                                                            HorizontalAlignment="Right"
                                                            VerticalAlignment="Center"
                                                            Command="{Binding DataContext.RemoveItemCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                            CommandParameter="{Binding}"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- Cart Bottom Grand Total Bar -->
                                <Border Background="{StaticResource SubtleSurfaceBrush}"
                                        CornerRadius="10"
                                        Padding="18,14"
                                        Margin="0,16,0,0">
                                    <Grid>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="Tổng số lượng trong giỏ: " FontSize="14" Foreground="{StaticResource MutedTextBrush}"/>
                                            <TextBlock Text="{Binding TotalQuantity, StringFormat='{}{0} cuốn'}" FontSize="14" FontWeight="Bold" Foreground="{StaticResource BrandDarkBlueBrush}"/>
                                        </StackPanel>

                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <TextBlock Text="Tổng cộng giỏ hàng: " FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <TextBlock Text="{Binding FormattedTotalAmount}"
                                                       FontSize="22"
                                                       FontWeight="Bold"
                                                       Foreground="{StaticResource BrandOrangeBrush}"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- Friendly Empty Cart State -->
                        <Border Style="{StaticResource CardPanelStyle}"
                                Padding="48,44"
                                Visibility="{Binding IsCartEmpty, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <StackPanel HorizontalAlignment="Center" MaxWidth="420">
                                <TextBlock Text="Giỏ hàng của bạn đang trống"
                                           FontSize="20"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource BrandDarkBlueBrush}"
                                           HorizontalAlignment="Center"
                                           Margin="0,0,0,8"/>
                                <TextBlock Text="Hãy quay lại trang chủ để khám phá các đầu sách hấp dẫn và thêm vào giỏ hàng trước khi thanh toán."
                                           FontSize="14"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           TextAlignment="Center"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,22"/>
                                <Button Content="Khám phá danh mục sách ngay"
                                        Command="{Binding ContinueShoppingCommand}"
                                        Style="{StaticResource PrimaryCtaButtonStyle}"
                                        HorizontalAlignment="Center"
                                        Padding="22,11"/>
                            </StackPanel>
                        </Border>

                    </StackPanel>

                    <!-- RIGHT COLUMN: B. CUSTOMER FORM, C. ORDER SUMMARY & D. CONFIRM BUTTON -->
                    <StackPanel Grid.Column="1">

                        <!-- Customer Information Form Card -->
                        <Border Style="{StaticResource CardPanelStyle}" Padding="24" Margin="0,0,0,20">
                            <StackPanel>
                                <TextBlock Text="Thông Tin Khách Hàng Nhận Sách" Style="{StaticResource SectionHeadingStyle}" Margin="0,0,0,6"/>
                                <TextBlock Text="Vui lòng điền đầy đủ các trường bắt buộc (*) bên dưới."
                                           FontSize="12.5"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           Margin="0,0,0,18"/>

                                <!-- 1. Full Name -->
                                <TextBlock Text="Họ và tên người nhận *" Style="{StaticResource FormFieldLabelStyle}"/>
                                <TextBox Text="{Binding HoTen, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource FormTextBoxStyle}"/>
                                <TextBlock Text="{Binding HoTenError}"
                                           Style="{StaticResource ValidationErrorTextStyle}"
                                           Visibility="{Binding HasHoTenError, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                                <!-- 2. Phone Number (Exactly 10 digits) -->
                                <TextBlock Text="Số điện thoại (10 chữ số) *" Style="{StaticResource FormFieldLabelStyle}" Margin="0,14,0,6"/>
                                <TextBox Text="{Binding SDT, UpdateSourceTrigger=PropertyChanged}"
                                         MaxLength="10"
                                         Style="{StaticResource FormTextBoxStyle}"/>
                                <TextBlock Text="{Binding SdtError}"
                                           Style="{StaticResource ValidationErrorTextStyle}"
                                           Visibility="{Binding HasSDTError, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                                <!-- 3. Email -->
                                <TextBlock Text="Email*" Style="{StaticResource FormFieldLabelStyle}" Margin="0,14,0,6"/>
                                <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormTextBoxStyle}"/>
                                <TextBlock Text="{Binding EmailError}"
                                           Style="{StaticResource ValidationErrorTextStyle}"
                                           Visibility="{Binding HasEmailError, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                                <!-- 4. Delivery Address -->
                                <TextBlock Text="Địa chỉ nhận hàng *" Style="{StaticResource FormFieldLabelStyle}" Margin="0,14,0,6"/>
                                <TextBox Text="{Binding DiaChi, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource FormTextBoxStyle}"
                                         Height="68"
                                         TextWrapping="Wrap"
                                         AcceptsReturn="True"
                                         VerticalContentAlignment="Top"/>
                                <TextBlock Text="{Binding DiaChiError}"
                                           Style="{StaticResource ValidationErrorTextStyle}"
                                           Visibility="{Binding HasDiaChiError, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                                <!-- 5. Payment Method -->
                                <TextBlock Text="Phương thức thanh toán *" Style="{StaticResource FormFieldLabelStyle}" Margin="0,14,0,6"/>
                                <ComboBox ItemsSource="{Binding PaymentMethods}"
                                          SelectedItem="{Binding SelectedPaymentMethod, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          Style="{StaticResource FormComboBoxStyle}"/>
                                <TextBlock Text="{Binding PaymentMethodError}"
                                           Style="{StaticResource ValidationErrorTextStyle}"
                                           Visibility="{Binding HasPaymentMethodError, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                                <!-- Bank Transfer QR Info Preview Banner when "Chuyển khoản" is selected -->
                                <Border Background="#EFF6FF"
                                        BorderBrush="#BFDBFE"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        Padding="14,12"
                                        Margin="0,12,0,0"
                                        Visibility="{Binding IsBankTransferSelected, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                            <Border Background="#1D4ED8" CornerRadius="4" Padding="6,2" Margin="0,0,8,0" VerticalAlignment="Center">
                                                <TextBlock Text="VietQR 24/7" Foreground="White" FontSize="10.5" FontWeight="Bold"/>
                                            </Border>
                                            <TextBlock Text="Thanh toán qua Mã QR cá nhân nhận tiền"
                                                       FontWeight="Bold"
                                                       FontSize="13"
                                                       Foreground="#1E3A8A"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>

                                        <TextBlock Text="{Binding BankName, StringFormat='• Ngân hàng: {0}'}"
                                                   FontSize="12.5"
                                                   Foreground="#1E40AF"
                                                   FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding BankAccountNo, StringFormat='• Số tài khoản: {0}'}"
                                                   FontSize="12.5"
                                                   Foreground="#1E40AF"
                                                   FontWeight="Bold"
                                                   Margin="0,2,0,0"/>
                                        <TextBlock Text="{Binding BankAccountName, StringFormat='• Chủ tài khoản: {0}'}"
                                                   FontSize="12.5"
                                                   Foreground="#1E40AF"
                                                   FontWeight="SemiBold"
                                                   Margin="0,2,0,6"/>

                                        <TextBlock Text="Khi bấm nút bên dưới, hệ thống sẽ hiện mã QR cá nhân với đúng số tiền &amp; nội dung chuyển khoản và đợi nhận tiền thành công để xác nhận đơn hàng."
                                                   FontSize="11.5"
                                                   Foreground="#3B82F6"
                                                   TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- C. Order Summary & D. Confirm Order Button Card -->
                        <Border Style="{StaticResource CardPanelStyle}" Padding="24">
                            <StackPanel>
                                <TextBlock Text="Tóm Tắt Đơn Hàng" Style="{StaticResource SectionHeadingStyle}" Margin="0,0,0,16"/>

                                <Grid Margin="0,0,0,10">
                                    <TextBlock Text="Tổng số lượng sách:" Foreground="{StaticResource MutedTextBrush}" FontSize="13.5"/>
                                    <TextBlock Text="{Binding TotalQuantity, StringFormat='{}{0} cuốn'}"
                                               HorizontalAlignment="Right"
                                               FontWeight="SemiBold"
                                               FontSize="13.5"/>
                                </Grid>

                                <Grid Margin="0,0,0,10">
                                    <TextBlock Text="Tạm tính:" Foreground="{StaticResource MutedTextBrush}" FontSize="13.5"/>
                                    <TextBlock Text="{Binding FormattedTotalAmount}"
                                               HorizontalAlignment="Right"
                                               FontWeight="SemiBold"
                                               FontSize="13.5"/>
                                </Grid>

                                <Grid Margin="0,0,0,14">
                                    <TextBlock Text="Phương thức thanh toán:" Foreground="{StaticResource MutedTextBrush}" FontSize="13.5"/>
                                    <TextBlock Text="{Binding NormalizedSelectedPayment}"
                                               HorizontalAlignment="Right"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource BrandDarkBlueBrush}"
                                               FontSize="13.5"/>
                                </Grid>

                                <Separator Background="{StaticResource BorderSubtleBrush}" Margin="0,0,0,14"/>

                                <Grid Margin="0,0,0,18">
                                    <TextBlock Text="Tổng thanh toán:" FontWeight="Bold" FontSize="16" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding FormattedTotalAmount}"
                                               HorizontalAlignment="Right"
                                               FontWeight="Bold"
                                               FontSize="24"
                                               Foreground="{StaticResource BrandOrangeBrush}"
                                               VerticalAlignment="Center"/>
                                </Grid>

                                <!-- General Validation / Checkout Error Alert -->
                                <Border Background="{StaticResource ErrorSoftBgBrush}"
                                        BorderBrush="#FECACA"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="12,10"
                                        Margin="0,0,0,14"
                                        Visibility="{Binding HasGeneralError, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <TextBlock Text="{Binding GeneralErrorMessage}"
                                               Foreground="{StaticResource ErrorRedBrush}"
                                               FontSize="12.5"
                                               FontWeight="SemiBold"
                                               TextWrapping="Wrap"/>
                                </Border>

                                <!-- Loading Indicator while checkout is processing -->
                                <Border Background="{StaticResource BrandDarkBlueLightBrush}"
                                        CornerRadius="8"
                                        Padding="12,10"
                                        Margin="0,0,0,14"
                                        Visibility="{Binding IsProcessingCheckout, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <StackPanel>
                                        <TextBlock Text="Đang kiểm tra tồn kho và khởi tạo đơn hàng..."
                                                   Foreground="{StaticResource BrandDarkBlueBrush}"
                                                   FontWeight="SemiBold"
                                                   FontSize="12.5"
                                                   Margin="0,0,0,6"/>
                                        <ProgressBar IsIndeterminate="True" Height="5" Foreground="{StaticResource BrandOrangeBrush}"/>
                                    </StackPanel>
                                </Border>

                                <!-- D. Confirm Order Call-to-Action Button (#E85D22) -->
                                <Button Content="{Binding CheckoutButtonText}"
                                        Command="{Binding ConfirmCheckoutCommand}"
                                        Style="{StaticResource PrimaryCtaButtonStyle}"
                                        FontSize="15"
                                        Padding="0,13"
                                        HorizontalAlignment="Stretch"/>

                                <TextBlock Text="* Nút Đặt hàng chỉ bật khi giỏ hàng có sách và thông tin họ tên, SĐT (đúng 10 số), email (@gmail.com), địa chỉ đã hợp lệ."
                                           FontSize="11.5"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           TextWrapping="Wrap"
                                           Margin="0,10,0,0"/>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </Grid>

            </StackPanel>
        </ScrollViewer>

        <!-- ==================== MODAL QR CODE THANH TOÁN CHUYỂN KHOẢN ==================== -->
        <Grid Background="#A60F172A"
              Visibility="{Binding IsQrPaymentModalOpen, Converter={StaticResource BooleanToVisibilityConverter}}"
              Panel.ZIndex="100">
            <Border Background="White"
                    CornerRadius="16"
                    MaxWidth="800"
                    Width="760"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Margin="24"
                    Padding="28,24"
                    Effect="{StaticResource ElevatedShadowEffect}">
                <StackPanel>
                    <!-- Modal Header -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Background="#DBEAFE" CornerRadius="6" Padding="8,3" Margin="0,0,10,0" VerticalAlignment="Center">
                                    <TextBlock Text="CHUYỂN KHOẢN QR" Foreground="#1E40AF" FontWeight="Bold" FontSize="11"/>
                                </Border>
                                <TextBlock Text="Quét Mã QR Cá Nhân Để Thanh Toán Đơn Hàng"
                                           FontSize="19"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource BrandDarkBlueBrush}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Text="{Binding PendingBankTransferOrder.OrderCode, StringFormat='Mã đơn hàng tạm: {0} — Vui lòng chuyển khoản đúng số tiền và nội dung bên dưới.'}"
                                       FontSize="13"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       Margin="0,4,0,0"/>
                        </StackPanel>

                        <Border Grid.Column="1"
                                Background="#FFF7ED"
                                BorderBrush="#FED7AA"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="12,6"
                                VerticalAlignment="Top">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⏱ Thời gian chờ: " FontSize="12.5" Foreground="#C2410C" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding QrCountdownText}" FontSize="14" FontWeight="Bold" Foreground="#EA580C" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Separator Background="{StaticResource BorderSubtleBrush}" Margin="0,0,0,18"/>

                    <!-- Two-Column QR & Bank Info Body -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="290"/>
                            <ColumnDefinition Width="24"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Left Column: QR Code Image Box -->
                        <Border Grid.Column="0"
                                Background="#F8FAFC"
                                BorderBrush="#E2E8F0"
                                BorderThickness="1.5"
                                CornerRadius="12"
                                Padding="16">
                            <StackPanel HorizontalAlignment="Center">
                                <Border Background="#1E3A8A" CornerRadius="6" Padding="10,4" HorizontalAlignment="Center" Margin="0,0,0,10">
                                    <TextBlock Text="VietQR • NAPAS 247" Foreground="White" FontWeight="Bold" FontSize="11.5"/>
                                </Border>

                                <!-- QR Image Container -->
                                <Border Background="White"
                                        BorderBrush="#CBD5E1"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        Width="240"
                                        Height="255"
                                        Padding="8">
                                    <Grid>
                                        <!-- Loading Spinner -->
                                        <StackPanel VerticalAlignment="Center"
                                                    HorizontalAlignment="Center"
                                                    Visibility="{Binding IsLoadingQrImage, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <ProgressBar IsIndeterminate="True" Width="120" Height="6" Foreground="{StaticResource BrandOrangeBrush}" Margin="0,0,0,10"/>
                                            <TextBlock Text="Đang tạo mã QR thanh toán..." FontSize="12" Foreground="{StaticResource MutedTextBrush}" HorizontalAlignment="Center"/>
                                        </StackPanel>

                                        <!-- Dynamic VietQR or Custom QR Image -->
                                        <Image Source="{Binding QrCodeImageSource}"
                                               Stretch="Uniform"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Visibility="{Binding HasQrCodeImage, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                                        <!-- Offline Fallback QR Display -->
                                        <StackPanel VerticalAlignment="Center"
                                                    HorizontalAlignment="Center"
                                                    Visibility="{Binding IsQrFallbackVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <Border Width="130" Height="130" BorderBrush="#1E3A8A" BorderThickness="2" CornerRadius="8" Background="#EFF6FF" Margin="0,0,0,10">
                                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                                    <TextBlock Text="QR CÁ NHÂN" FontWeight="Bold" FontSize="13" Foreground="#1E3A8A" HorizontalAlignment="Center"/>
                                                    <TextBlock Text="{Binding BankId}" FontWeight="Bold" FontSize="18" Foreground="#EA580C" HorizontalAlignment="Center" Margin="0,4,0,4"/>
                                                    <TextBlock Text="{Binding BankAccountNo}" FontWeight="SemiBold" FontSize="12" Foreground="#1E40AF" HorizontalAlignment="Center"/>
                                                </StackPanel>
                                            </Border>
                                            <TextBlock Text="Quét QR hoặc chuyển khoản theo STK bên cạnh"
                                                       FontSize="11.5"
                                                       Foreground="{StaticResource MutedTextBrush}"
                                                       TextAlignment="Center"
                                                       TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <TextBlock Text="Mở App Ngân hàng bất kỳ để quét mã QR"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource BrandDarkBlueBrush}"
                                           HorizontalAlignment="Center"
                                           Margin="0,10,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Right Column: Transfer Details & Waiting Status -->
                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                            <TextBlock Text="Thông Tin Tài Khoản Nhận Tiền Cá Nhân"
                                       FontSize="15"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource BrandDarkBlueBrush}"
                                       Margin="0,0,0,12"/>

                            <!-- Bank Info Table -->
                            <Border Background="#F8FAFC"
                                    BorderBrush="#E2E8F0"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="16,12"
                                    Margin="0,0,0,14">
                                <StackPanel>
                                    <!-- Bank Name -->
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="135"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Ngân hàng:" Foreground="{StaticResource MutedTextBrush}" FontSize="13" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="{Binding BankName}" FontWeight="Bold" FontSize="13.5" Foreground="{StaticResource CharcoalTextBrush}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                    </Grid>

                                    <!-- Account Holder -->
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="135"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Chủ tài khoản:" Foreground="{StaticResource MutedTextBrush}" FontSize="13" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="{Binding BankAccountName}" FontWeight="Bold" FontSize="14" Foreground="#1E3A8A" VerticalAlignment="Center"/>
                                    </Grid>

                                    <!-- Account Number -->
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="135"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Số tài khoản:" Foreground="{StaticResource MutedTextBrush}" FontSize="13" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="{Binding BankAccountNo}" FontWeight="Bold" FontSize="15" Foreground="#0F172A" VerticalAlignment="Center"/>
                                        <Button Grid.Column="2"
                                                Content="Sao chép"
                                                Command="{Binding CopyBankAccountNoCommand}"
                                                Style="{StaticResource SecondaryOutlineButtonStyle}"
                                                FontSize="11.5"
                                                Padding="10,4"/>
                                    </Grid>

                                    <!-- Transfer Amount -->
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="135"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Số tiền thanh toán:" Foreground="{StaticResource MutedTextBrush}" FontSize="13" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="{Binding QrAmountFormatted}" FontWeight="Bold" FontSize="17" Foreground="{StaticResource BrandOrangeBrush}" VerticalAlignment="Center"/>
                                        <Button Grid.Column="2"
                                                Content="Sao chép"
                                                Command="{Binding CopyTransferAmountCommand}"
                                                Style="{StaticResource SecondaryOutlineButtonStyle}"
                                                FontSize="11.5"
                                                Padding="10,4"/>
                                    </Grid>

                                    <!-- Transfer Content -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="135"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Nội dung CK:" Foreground="{StaticResource MutedTextBrush}" FontSize="13" VerticalAlignment="Center"/>
                                        <Border Grid.Column="1" Background="#FEF3C7" CornerRadius="6" Padding="8,4" HorizontalAlignment="Left" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding QrTransferContent}" FontWeight="Bold" FontSize="13.5" Foreground="#B45309"/>
                                        </Border>
                                        <Button Grid.Column="2"
                                                Content="Sao chép"
                                                Command="{Binding CopyTransferContentCommand}"
                                                Style="{StaticResource SecondaryOutlineButtonStyle}"
                                                FontSize="11.5"
                                                Padding="10,4"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Copy Feedback Toast -->
                            <Border Background="#DCFCE7"
                                    CornerRadius="6"
                                    Padding="10,6"
                                    Margin="0,0,0,10"
                                    Visibility="{Binding HasCopyFeedback, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock Text="{Binding CopyFeedbackText}"
                                           Foreground="#15803D"
                                           FontSize="12"
                                           FontWeight="SemiBold"/>
                            </Border>

                            <!-- Live Waiting Status Banner -->
                            <Border Background="#EFF6FF"
                                    BorderBrush="#BFDBFE"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="14,12">
                                <StackPanel>
                                    <TextBlock Text="{Binding QrStatusMessage}"
                                               Foreground="#1E3A8A"
                                               FontWeight="SemiBold"
                                               FontSize="12.5"
                                               TextWrapping="Wrap"
                                               Margin="0,0,0,8"/>
                                    <ProgressBar IsIndeterminate="True" Height="5" Foreground="#2563EB"/>
                                    <TextBlock Text="Lưu ý: Sau khi chuyển khoản xong, vui lòng bấm 'Tôi Đã Chuyển Khoản (Báo Nhân viên duyệt)' bên dưới. Nhân viên kiểm tra nhận được tiền sẽ bấm 'Duyệt CK' để xác nhận đơn hàng của bạn."
                                               FontSize="11.5"
                                               Foreground="#475569"
                                               TextWrapping="Wrap"
                                               Margin="0,8,0,0"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <Separator Background="{StaticResource BorderSubtleBrush}" Margin="0,18,0,16"/>

                    <!-- Modal Footer Buttons -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0"
                                Content="✕ Hủy / Quay lại giỏ hàng"
                                Command="{Binding CancelQrPaymentCommand}"
                                Style="{StaticResource RemoveItemButtonStyle}"
                                Padding="14,10"/>

                        <Button Grid.Column="2"
                                Content="✓ Tôi Đã Chuyển Khoản (Báo Nhân viên duyệt thanh toán)"
                                Command="{Binding SubmitWaitingStaffVerificationCommand}"
                                Style="{StaticResource PrimaryCtaButtonStyle}"
                                Padding="20,10"
                                ToolTip="Gửi thông báo đã chuyển khoản đến Nhân viên để kiểm tra tiền về và duyệt đơn hàng"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Page>
