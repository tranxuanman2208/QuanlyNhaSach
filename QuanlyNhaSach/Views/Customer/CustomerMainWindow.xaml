<Window x:Class="QuanlyNhaSach.Views.Customer.CustomerMainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="BookNest — Cửa Hàng Sách Trực Tuyến (Phân Hệ Khách Hàng)"
        Height="820" Width="1280"
        MinHeight="640" MinWidth="1020"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource MainBackgroundBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <!-- Fixed Top Navigation Bar -->
            <RowDefinition Height="Auto"/>
            <!-- Content Frame -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 1. PERSISTENT TOP NAVIGATION BAR (#1E3A8A) -->
        <Border Grid.Row="0"
                Background="{StaticResource BrandDarkBlueBrush}"
                Padding="28,13"
                BorderBrush="#172E6E"
                BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <!-- Left: Brand Logo -->
                    <ColumnDefinition Width="Auto"/>
                    <!-- Center: Global Search Bar + Search Button -->
                    <ColumnDefinition Width="*"/>
                    <!-- Right: Home, Cart, Customer Info & Logout -->
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left: BookNest Brand Logo (Clickable -> HomePage) -->
                <Border Grid.Column="0"
                        Background="Transparent"
                        Cursor="Hand"
                        Margin="0,0,28,0"
                        VerticalAlignment="Center"
                        ToolTip="Về Trang chủ BookNest">
                    <Border.InputBindings>
                        <MouseBinding Gesture="LeftClick" Command="{Binding NavigateHomeCommand}"/>
                    </Border.InputBindings>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="42" Height="42" CornerRadius="10" Background="{StaticResource BrandOrangeBrush}" Margin="0,0,12,0">
                            <Path Data="{StaticResource IconBookGeometry}"
                                  Fill="White"
                                  Width="20" Height="20"
                                  Stretch="Uniform"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding BrandName}"
                                       FontSize="20"
                                       FontWeight="Bold"
                                       Foreground="White"/>
                            <TextBlock Text="{Binding BrandTagline}"
                                       FontSize="11.5"
                                       Foreground="#BFDBFE"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Center: Search Input + Adjacent Search Button -->
                <Grid Grid.Column="1" MaxWidth="520" VerticalAlignment="Center" Margin="0,0,20,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Search TextBox with Enter KeyBinding -->
                    <Grid Grid.Column="0" Margin="0,0,10,0">
                        <TextBox x:Name="GlobalSearchTextBox"
                                 Text="{Binding SearchKeyword, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource FormTextBoxStyle}"
                                 Padding="38,9,32,9"
                                 FontSize="14">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Return" Command="{Binding SearchCommand}"/>
                                <KeyBinding Key="Enter" Command="{Binding SearchCommand}"/>
                            </TextBox.InputBindings>
                        </TextBox>

                        <!-- Search Icon -->
                        <Path Data="{StaticResource IconSearchGeometry}"
                              Fill="#64748B"
                              Width="15" Height="15"
                              Stretch="Uniform"
                              VerticalAlignment="Center"
                              HorizontalAlignment="Left"
                              Margin="13,0,0,0"
                              IsHitTestVisible="False"/>

                        <!-- Watermark Placeholder -->
                        <TextBlock Text="Tìm kiếm sách theo tên sách hoặc tác giả..."
                                   FontSize="13.5"
                                   Foreground="#94A3B8"
                                   VerticalAlignment="Center"
                                   Margin="38,0,0,0"
                                   IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SearchKeyword}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding SearchKeyword}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <!-- Clear Search Button -->
                        <Button Content="✕"
                                Command="{Binding ClearSearchCommand}"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Margin="0,0,8,0"
                                Width="22" Height="22"
                                Background="Transparent"
                                BorderThickness="0"
                                Foreground="#64748B"
                                FontWeight="Bold"
                                Cursor="Hand"
                                ToolTip="Xóa từ khóa và hiển thị toàn bộ sách">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SearchKeyword}" Value="">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding SearchKeyword}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </Grid>

                    <!-- Search Button (#E85D22) -->
                    <Button Grid.Column="1"
                            Content="Tìm kiếm"
                            Command="{Binding SearchCommand}"
                            Style="{StaticResource PrimaryCtaButtonStyle}"
                            Padding="18,9"/>
                </Grid>

                <!-- Right: Home, Cart, Authenticated Customer Badge & Logout -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">

                    <!-- Home Button -->
                    <Button Command="{Binding NavigateHomeCommand}"
                            Style="{StaticResource HeaderNavButtonStyle}"
                            Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Trang chủ" Foreground="White" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Cart Button with Live Badge -->
                    <Button Command="{Binding NavigateCartCommand}"
                            Style="{StaticResource HeaderNavButtonStyle}"
                            Margin="0,0,14,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Giỏ hàng" Foreground="White" FontWeight="SemiBold" VerticalAlignment="Center"/>

                            <!-- Live Cart Quantity Badge (#E85D22) -->
                            <Border Style="{StaticResource CartBadgeBorderStyle}"
                                    Margin="8,0,0,0">
                                <TextBlock Text="{Binding TotalQuantity}"
                                           Foreground="White"
                                           FontWeight="Bold"
                                           FontSize="11.5"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>
                        </StackPanel>
                    </Button>

                    <!-- Authenticated Customer Identity Pill (Clickable -> CustomerProfilePage) -->
                    <Border Background="#172B4D"
                            BorderBrush="#3358B8"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="12,6"
                            Margin="0,0,10,0"
                            Cursor="Hand"
                            ToolTip="Xem thông tin tài khoản của tôi"
                            VerticalAlignment="Center">
                        <Border.InputBindings>
                            <MouseBinding Gesture="LeftClick" Command="{Binding NavigateProfileCommand}"/>
                        </Border.InputBindings>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="{StaticResource IconUserGeometry}"
                                  Fill="#93C5FD"
                                  Width="15" Height="15"
                                  Stretch="Uniform"
                                  Margin="0,0,8,0"
                                  VerticalAlignment="Center"/>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding CustomerFullName}"
                                           Foreground="White"
                                           FontWeight="Bold"
                                           FontSize="12.5"/>
                                <TextBlock Text="{Binding CustomerRoleLabel}"
                                           Foreground="#93C5FD"
                                           FontSize="10.5"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Logout Button -->
                    <Button Command="{Binding LogoutCommand}"
                            Style="{StaticResource HeaderNavButtonStyle}"
                            Background="#B91C1C"
                            Padding="12,9"
                            ToolTip="Đăng xuất và quay về màn hình Đăng nhập">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="{StaticResource IconLogoutGeometry}"
                                  Fill="White"
                                  Width="14" Height="14"
                                  Stretch="Uniform"
                                  Margin="0,0,6,0"
                                  VerticalAlignment="Center"/>
                            <TextBlock Text="Đăng xuất" Foreground="White" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                </StackPanel>
            </Grid>
        </Border>

        <!-- 2. CONTENT FRAME -->
        <Frame x:Name="MainFrame"
               Grid.Row="1"
               NavigationUIVisibility="Hidden"/>
    </Grid>
</Window>
