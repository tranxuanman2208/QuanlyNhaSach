<Page x:Class="QuanlyNhaSach.Views.Staff.StaffOrderProcessingPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      mc:Ignorable="d"
      d:DesignHeight="780" d:DesignWidth="1060"
      Title="StaffOrderProcessingPage"
      Background="{StaticResource SubtleSurfaceBrush}">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="32,26,32,36">

            <!-- 1. FILTER & SEARCH BAR -->
            <Border Style="{StaticResource CardPanelStyle}" Padding="24,18" Margin="0,0,0,18">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="240"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Status Filter ComboBox -->
                    <StackPanel Grid.Column="0" Margin="0,0,16,0">
                        <TextBlock Text="Lọc theo trạng thái đơn hàng" Style="{StaticResource FormFieldLabelStyle}"/>
                        <ComboBox ItemsSource="{Binding StatusFilterOptions}"
                                  SelectedItem="{Binding SelectedStatusFilter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  Style="{StaticResource FormComboBoxStyle}"/>
                    </StackPanel>

                    <!-- Search by Order ID / Customer -->
                    <StackPanel Grid.Column="1" Margin="0,0,16,0">
                        <TextBlock Text="Tìm theo Mã ĐH hoặc Tên / SĐT khách hàng" Style="{StaticResource FormFieldLabelStyle}"/>
                        <TextBox Text="{Binding SearchKeyword, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource FormTextBoxStyle}"/>
                    </StackPanel>

                    <!-- Reset Filters Button -->
                    <Button Grid.Column="2"
                            Content="Đặt lại bộ lọc"
                            Command="{Binding ResetFiltersCommand}"
                            Style="{StaticResource SecondaryOutlineButtonStyle}"
                            VerticalAlignment="Bottom"
                            Padding="16,9"/>
                </Grid>
            </Border>

            <!-- 2. OPERATION FEEDBACK BANNER -->
            <Border CornerRadius="10"
                    Padding="18,12"
                    Margin="0,0,0,18"
                    BorderThickness="1"
                    Visibility="{Binding HasFeedback, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="{StaticResource SuccessSoftBgBrush}"/>
                        <Setter Property="BorderBrush" Value="#6EE7B7"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsFeedbackSuccess}" Value="False">
                                <Setter Property="Background" Value="{StaticResource ErrorSoftBgBrush}"/>
                                <Setter Property="BorderBrush" Value="#FECACA"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock Text="{Binding FeedbackMessage}"
                           FontWeight="SemiBold"
                           FontSize="13"
                           TextWrapping="Wrap">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{StaticResource SuccessGreenBrush}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsFeedbackSuccess}" Value="False">
                                    <Setter Property="Foreground" Value="{StaticResource ErrorRedBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Border>

            <!-- 3. ORDERS TABLE (UC07) -->
            <Border Style="{StaticResource CardPanelStyle}" Padding="24" Margin="0,0,0,20">
                <StackPanel>
                    <Grid Margin="0,0,0,14">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Danh Sách Đơn Hàng Cần Xử Lý" Style="{StaticResource SectionHeadingStyle}"/>
                            <Border Background="{StaticResource BrandDarkBlueLightBrush}" CornerRadius="10" Padding="10,2" Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding DisplayedOrders.Count, StringFormat='{}{0} đơn hàng'}"
                                           Foreground="{StaticResource BrandDarkBlueBrush}"
                                           FontWeight="Bold"
                                           FontSize="12"/>
                            </Border>
                        </StackPanel>

                        <TextBlock Text="Quy trình chuẩn: Mới → Đã xác nhận → (Xuất kho) → Đang giao → (Thanh toán) → Hoàn tất"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center"/>
                    </Grid>

                    <DataGrid ItemsSource="{Binding DisplayedOrders}"
                              SelectedItem="{Binding SelectedOrder, Mode=TwoWay}"
                              Style="{StaticResource AdminDataGridStyle}"
                              Visibility="{Binding HasOrders, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <DataGrid.Columns>
                            <!-- Order ID -->
                            <DataGridTextColumn Header="Mã ĐH" Binding="{Binding OrderCode}" Width="78">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Setter Property="Foreground" Value="{StaticResource BrandDarkBlueBrush}"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- Customer -->
                            <DataGridTemplateColumn Header="Khách hàng" Width="1.15*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel>
                                            <TextBlock Text="{Binding HoTenKhachHang}" FontWeight="SemiBold" Foreground="{StaticResource CharcoalTextBrush}"/>
                                            <TextBlock Text="{Binding SDTKhachHang}" FontSize="11.5" Foreground="{StaticResource MutedTextBrush}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Order Date -->
                            <DataGridTextColumn Header="Ngày đặt" Binding="{Binding FormattedNgayDat}" Width="122"/>

                            <!-- Total Amount -->
                            <DataGridTextColumn Header="Tổng tiền" Binding="{Binding FormattedTongTien}" Width="110">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Setter Property="Foreground" Value="{StaticResource BrandOrangeBrush}"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- Payment Method -->
                            <DataGridTextColumn Header="PT Thanh toán" Binding="{Binding PhuongThucThanhToan}" Width="105"/>

                            <!-- Payment Status -->
                            <DataGridTemplateColumn Header="TT Thanh toán" Width="125">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource StatusBadgeBorderStyle}"
                                                Background="{Binding TrangThaiThanhToan, Converter={StaticResource PaymentStatusBadgeBackgroundConverter}}">
                                            <TextBlock Text="{Binding TrangThaiThanhToan}"
                                                       FontWeight="Bold"
                                                       FontSize="11"
                                                       Foreground="{Binding TrangThaiThanhToan, Converter={StaticResource PaymentStatusBadgeForegroundConverter}}"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Current Order Status -->
                            <DataGridTemplateColumn Header="Trạng thái ĐH" Width="115">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource StatusBadgeBorderStyle}"
                                                Background="{Binding TrangThai, Converter={StaticResource OrderStatusBadgeBackgroundConverter}}">
                                            <TextBlock Text="{Binding TrangThai}"
                                                       FontWeight="Bold"
                                                       FontSize="11.5"
                                                       Foreground="{Binding TrangThai, Converter={StaticResource OrderStatusBadgeForegroundConverter}}"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Status Transition Dropdown & Actions -->
                            <DataGridTemplateColumn Header="Chuyển trạng thái &amp; Thao tác" Width="310">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <ComboBox Width="122"
                                                      ItemsSource="{Binding DataContext.TransitionOptions, RelativeSource={RelativeSource AncestorType=Page}}"
                                                      SelectedItem="{Binding SelectedTransitionLabel, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                      IsEnabled="{Binding CanTransitionStatus}"
                                                      Style="{StaticResource FormComboBoxStyle}"
                                                      FontSize="12"
                                                      Padding="8,5"
                                                      Margin="0,0,6,0"/>

                                            <Button Content="Cập nhật"
                                                    Command="{Binding DataContext.ApplyStatusTransitionCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                    CommandParameter="{Binding}"
                                                    IsEnabled="{Binding CanTransitionStatus}"
                                                    Style="{StaticResource PrimaryCtaButtonStyle}"
                                                    FontSize="11.5"
                                                    Padding="10,6"
                                                    Margin="0,0,6,0"/>

                                            <Button Content="Xuất kho"
                                                    Command="{Binding DataContext.OpenStockOutCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource SecondaryOutlineButtonStyle}"
                                                    FontSize="11.5"
                                                    Padding="8,6"
                                                    Margin="0,0,4,0"/>

                                            <Button Content="Thu tiền"
                                                    Command="{Binding DataContext.OpenSalesCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource SecondaryOutlineButtonStyle}"
                                                    FontSize="11.5"
                                                    Padding="8,6"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Empty Filtered State -->
                    <Border Background="{StaticResource SubtleSurfaceBrush}"
                            CornerRadius="10"
                            Padding="36,28"
                            Visibility="{Binding IsEmptyOrders, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="Không có đơn hàng nào khớp với bộ lọc hiện tại"
                                       FontSize="15.5"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource BrandDarkBlueBrush}"
                                       HorizontalAlignment="Center"/>
                            <Button Content="Xem tất cả đơn hàng"
                                    Command="{Binding ResetFiltersCommand}"
                                    Style="{StaticResource SecondaryOutlineButtonStyle}"
                                    HorizontalAlignment="Center"
                                    Margin="0,12,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- 4. SELECTED ORDER DETAIL & QUICK WORKFLOW PANEL -->
            <Border Style="{StaticResource CardPanelStyle}"
                    Padding="24"
                    Visibility="{Binding HasSelectedOrder, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel>
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{Binding SelectedOrder.DisplayTitle}"
                                       FontSize="17"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource BrandDarkBlueBrush}"/>
                            <TextBlock Text="{Binding SelectedOrder.DiaChiGiaoHang, StringFormat='Địa chỉ giao hàng: {0}'}"
                                       FontSize="13"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       Margin="0,3,0,0"/>
                            <TextBlock Text="{Binding SelectedOrder.RequiredActionText, StringFormat='Gợi ý bước tiếp theo: {0}'}"
                                       FontSize="12.5"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource BrandOrangeBrush}"
                                       Margin="0,3,0,0"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="1. Xác nhận đơn (Mới → Đã xác nhận)"
                                    Command="{Binding QuickConfirmOrderCommand}"
                                    CommandParameter="{Binding SelectedOrder}"
                                    Style="{StaticResource SecondaryOutlineButtonStyle}"
                                    Margin="0,0,8,0"/>
                            <Button Content="2. Giao hàng (Đã xác nhận → Đang giao)"
                                    Command="{Binding QuickShipOrderCommand}"
                                    CommandParameter="{Binding SelectedOrder}"
                                    Style="{StaticResource SecondaryOutlineButtonStyle}"
                                    Margin="0,0,8,0"/>
                            <Button Content="3. Hoàn tất đơn (Đang giao → Hoàn tất)"
                                    Command="{Binding QuickCompleteOrderCommand}"
                                    CommandParameter="{Binding SelectedOrder}"
                                    Style="{StaticResource PrimaryCtaButtonStyle}"/>
                        </StackPanel>
                    </Grid>

                    <DataGrid ItemsSource="{Binding SelectedOrder.Items}"
                              Style="{StaticResource AdminDataGridStyle}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Mã sách" Binding="{Binding MaSach, StringFormat='#{0}'}" Width="90"/>
                            <DataGridTextColumn Header="Tên sách" Binding="{Binding TenSach}" Width="2*"/>
                            <DataGridTextColumn Header="Tác giả" Binding="{Binding TacGia}" Width="1.2*"/>
                            <DataGridTextColumn Header="Đơn giá lúc đặt" Binding="{Binding FormattedDonGia}" Width="135"/>
                            <DataGridTextColumn Header="Số lượng đặt" Binding="{Binding SoLuongMua}" Width="115"/>
                            <DataGridTextColumn Header="Thành tiền" Binding="{Binding FormattedThanhTien}" Width="140">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Setter Property="Foreground" Value="{StaticResource BrandOrangeBrush}"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
