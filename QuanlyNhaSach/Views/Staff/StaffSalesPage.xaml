<Page x:Class="QuanlyNhaSach.Views.Staff.StaffSalesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      mc:Ignorable="d"
      d:DesignHeight="780" d:DesignWidth="1060"
      Title="StaffSalesPage"
      Background="{StaticResource SubtleSurfaceBrush}">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="32,26,32,36">

            <!-- Operation Feedback Banner -->
            <Border CornerRadius="10"
                    Padding="18,12"
                    Margin="0,0,0,20"
                    BorderThickness="1"
                    Visibility="{Binding HasFeedback, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="{StaticResource SuccessSoftBgBrush}"/>
                        <Setter Property="BorderBrush" Value="#6EE7B7"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsFeedbackSuccess}" Value="False">
                                <Setter Property="Background" Value="{StaticResource ErrorSoftBgBrush}"/>
                                <Setter Property="BorderBrush" Value="#FECACA"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock Text="{Binding FeedbackMessage}"
                           FontWeight="SemiBold"
                           FontSize="13"
                           TextWrapping="Wrap">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{StaticResource SuccessGreenBrush}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsFeedbackSuccess}" Value="False">
                                    <Setter Property="Foreground" Value="{StaticResource ErrorRedBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Border>

            <!-- TWO-COLUMN SALES & PAYMENT RECORDING LAYOUT (UC08) -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.35*"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>

                <!-- ==================== LEFT COLUMN: ORDER & PURCHASED BOOKS ==================== -->
                <StackPanel Grid.Column="0" Margin="0,0,22,0">

                    <!-- Order Selector & Search Card -->
                    <Border Style="{StaticResource CardPanelStyle}" Padding="24,20" Margin="0,0,0,20">
                        <StackPanel>
                            <TextBlock Text="1. Chọn Đơn Hàng Cần Ghi Nhận Thanh Toán" Style="{StaticResource SectionHeadingStyle}" Margin="0,0,0,12"/>

                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBox Grid.Column="0"
                                         Text="{Binding OrderSearchKeyword, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource FormTextBoxStyle}"
                                         Margin="0,0,10,0">
                                    <TextBox.InputBindings>
                                        <KeyBinding Key="Return" Command="{Binding SearchOrderCommand}"/>
                                        <KeyBinding Key="Enter" Command="{Binding SearchOrderCommand}"/>
                                    </TextBox.InputBindings>
                                </TextBox>

                                <Button Grid.Column="1"
                                        Content="Tìm đơn"
                                        Command="{Binding SearchOrderCommand}"
                                        Style="{StaticResource SecondaryOutlineButtonStyle}"
                                        Margin="0,0,8,0"/>

                                <Button Grid.Column="2"
                                        Content="Tất cả"
                                        Command="{Binding ClearSearchCommand}"
                                        Style="{StaticResource SecondaryOutlineButtonStyle}"/>
                            </Grid>

                            <TextBlock Text="Danh sách đơn hàng trong phiên hiện tại:" Style="{StaticResource FormFieldLabelStyle}"/>
                            <ComboBox ItemsSource="{Binding AvailableOrders}"
                                      SelectedItem="{Binding SelectedOrder, Mode=TwoWay}"
                                      DisplayMemberPath="DisplayTitle"
                                      Style="{StaticResource FormComboBoxStyle}"/>
                        </StackPanel>
                    </Border>

                    <!-- Selected Order Info & Purchased Books Card -->
                    <Border Style="{StaticResource CardPanelStyle}"
                            Padding="24"
                            Visibility="{Binding HasSelectedOrder, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel>
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{Binding SelectedOrder.OrderCode, StringFormat='Thông Tin Đơn Hàng {0}'}"
                                               Style="{StaticResource SectionHeadingStyle}"/>
                                    <TextBlock Text="{Binding SelectedOrder.FormattedNgayDat, StringFormat='Ngày đặt hàng: {0}'}"
                                               FontSize="12.5"
                                               Foreground="{StaticResource MutedTextBrush}"
                                               Margin="0,3,0,0"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Style="{StaticResource StatusBadgeBorderStyle}"
                                            Background="{Binding SelectedOrder.TrangThai, Converter={StaticResource OrderStatusBadgeBackgroundConverter}}"
                                            Margin="0,0,8,0">
                                        <TextBlock Text="{Binding SelectedOrder.TrangThai}"
                                                   FontWeight="Bold"
                                                   FontSize="12"
                                                   Foreground="{Binding SelectedOrder.TrangThai, Converter={StaticResource OrderStatusBadgeForegroundConverter}}"/>
                                    </Border>

                                    <Border Style="{StaticResource StatusBadgeBorderStyle}"
                                            Background="{Binding SelectedOrder.TrangThaiXuatKho, Converter={StaticResource StockOutStatusBadgeBackgroundConverter}}">
                                        <TextBlock Text="{Binding SelectedOrder.TrangThaiXuatKho}"
                                                   FontWeight="Bold"
                                                   FontSize="12"
                                                   Foreground="{Binding SelectedOrder.TrangThaiXuatKho, Converter={StaticResource StockOutStatusBadgeForegroundConverter}}"/>
                                    </Border>
                                </StackPanel>
                            </Grid>

                            <!-- Customer Summary Box -->
                            <Border Background="{StaticResource SubtleSurfaceBrush}"
                                    BorderBrush="{StaticResource BorderSubtleBrush}"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="16,12"
                                    Margin="0,0,0,18">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Khách hàng:" FontSize="12" Foreground="{StaticResource MutedTextBrush}"/>
                                        <TextBlock Text="{Binding SelectedOrder.CustomerSummary}" FontWeight="Bold" FontSize="14" Foreground="{StaticResource CharcoalTextBrush}" Margin="0,2,0,0"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Địa chỉ nhận hàng:" FontSize="12" Foreground="{StaticResource MutedTextBrush}"/>
                                        <TextBlock Text="{Binding SelectedOrder.DiaChiGiaoHang}" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource BodyTextBrush}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Purchased Books Table -->
                            <TextBlock Text="Danh sách sách đã mua trong đơn:" FontWeight="Bold" FontSize="14" Margin="0,0,0,10"/>

                            <DataGrid ItemsSource="{Binding SelectedOrderItems}"
                                      Style="{StaticResource AdminDataGridStyle}"
                                      Margin="0,0,0,16">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Mã" Binding="{Binding MaSach, StringFormat='#{0}'}" Width="65"/>
                                    <DataGridTextColumn Header="Tên sách" Binding="{Binding TenSach}" Width="1.8*">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                                <Setter Property="TextWrapping" Value="Wrap"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="Đơn giá" Binding="{Binding FormattedDonGia}" Width="115"/>
                                    <DataGridTextColumn Header="SL" Binding="{Binding SoLuongMua}" Width="65"/>
                                    <DataGridTextColumn Header="Thành tiền" Binding="{Binding FormattedThanhTien}" Width="125">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="FontWeight" Value="Bold"/>
                                                <Setter Property="Foreground" Value="{StaticResource BrandOrangeBrush}"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                </DataGrid.Columns>
                            </DataGrid>

                            <!-- Order Total Bar -->
                            <Border Background="{StaticResource BrandDarkBlueLightBrush}"
                                    CornerRadius="10"
                                    Padding="18,14">
                                <Grid>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="Tổng số lượng sách: " FontSize="13.5" Foreground="{StaticResource MutedTextBrush}"/>
                                        <TextBlock Text="{Binding SelectedOrder.TotalQuantity, StringFormat='{}{0} cuốn'}" FontSize="13.5" FontWeight="Bold" Foreground="{StaticResource BrandDarkBlueBrush}"/>
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <TextBlock Text="Tổng tiền đơn hàng: " FontSize="14.5" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBlock Text="{Binding SelectedOrder.FormattedTongTien}"
                                                   FontSize="22"
                                                   FontWeight="Bold"
                                                   Foreground="{StaticResource BrandOrangeBrush}"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ==================== RIGHT COLUMN: PAYMENT FORM ==================== -->
                <StackPanel Grid.Column="1">
                    <Border Style="{StaticResource CardPanelStyle}" Padding="24">
                        <StackPanel>
                            <TextBlock Text="2. Biểu Mẫu Ghi Nhận Thanh Toán" Style="{StaticResource SectionHeadingStyle}" Margin="0,0,0,6"/>
                            <TextBlock Text="Chọn phương thức thanh toán và kiểm tra số tiền trước khi xác nhận."
                                       FontSize="13"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       Margin="0,0,0,18"/>

                            <!-- Current Order Summary Box -->
                            <Border Background="{StaticResource SubtleSurfaceBrush}"
                                    BorderBrush="{StaticResource BorderSubtleBrush}"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="16,14"
                                    Margin="0,0,0,18">
                                <StackPanel>
                                    <Grid Margin="0,0,0,8">
                                        <TextBlock Text="Mã đơn hàng đang chọn:" FontSize="13" Foreground="{StaticResource MutedTextBrush}"/>
                                        <TextBlock Text="{Binding SelectedOrder.OrderCode}" FontSize="14" FontWeight="Bold" Foreground="{StaticResource BrandDarkBlueBrush}" HorizontalAlignment="Right"/>
                                    </Grid>

                                    <Grid Margin="0,0,0,8">
                                        <TextBlock Text="Tổng tiền cần thanh toán:" FontSize="13" Foreground="{StaticResource MutedTextBrush}"/>
                                        <TextBlock Text="{Binding SelectedOrder.FormattedTongTien}" FontSize="16" FontWeight="Bold" Foreground="{StaticResource BrandOrangeBrush}" HorizontalAlignment="Right"/>
                                    </Grid>

                                    <Grid>
                                        <TextBlock Text="Trạng thái thanh toán hiện tại:" FontSize="13" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center"/>
                                        <Border Style="{StaticResource StatusBadgeBorderStyle}"
                                                HorizontalAlignment="Right"
                                                Background="{Binding SelectedOrder.TrangThaiThanhToan, Converter={StaticResource PaymentStatusBadgeBackgroundConverter}}">
                                            <TextBlock Text="{Binding SelectedOrder.TrangThaiThanhToan}"
                                                       FontWeight="Bold"
                                                       FontSize="12"
                                                       Foreground="{Binding SelectedOrder.TrangThaiThanhToan, Converter={StaticResource PaymentStatusBadgeForegroundConverter}}"/>
                                        </Border>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Payment Method Selection -->
                            <TextBlock Text="Phương thức thanh toán *" Style="{StaticResource FormFieldLabelStyle}"/>
                            <ComboBox ItemsSource="{Binding PaymentMethodOptions}"
                                      SelectedItem="{Binding SelectedPaymentMethodLabel, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      Style="{StaticResource FormComboBoxStyle}"
                                      Margin="0,0,0,14"/>

                            <!-- Explicit COD Delivery Collection Checkbox (When COD & Order is Shipping) -->
                            <Border Background="{StaticResource BrandOrangeLightBrush}"
                                    BorderBrush="{StaticResource BrandOrangeBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="12,10"
                                    Margin="0,0,0,14"
                                    Visibility="{Binding CanShowCodDeliveryCheck, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <CheckBox IsChecked="{Binding ConfirmCodCollectionOnDelivery, Mode=TwoWay}"
                                          VerticalContentAlignment="Center">
                                    <TextBlock Text="Xác nhận nhân viên giao hàng đã thu đủ tiền mặt COD từ khách và hoàn tất đơn"
                                               FontSize="12.5"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource CharcoalTextBrush}"
                                               TextWrapping="Wrap"/>
                                </CheckBox>
                            </Border>

                            <!-- Payment Amount Input -->
                            <StackPanel Visibility="{Binding IsAmountInputRequired, Converter={StaticResource BooleanToVisibilityConverter}}"
                                        Margin="0,0,0,14">
                                <Grid Margin="0,0,0,6">
                                    <TextBlock Text="Số tiền thanh toán / khách đưa (VNĐ) *" Style="{StaticResource FormFieldLabelStyle}" Margin="0"/>
                                    <Button Content="Điền đúng tổng tiền"
                                            Command="{Binding FillExactAmountCommand}"
                                            Style="{StaticResource SecondaryOutlineButtonStyle}"
                                            FontSize="11.5"
                                            Padding="8,3"
                                            HorizontalAlignment="Right"/>
                                </Grid>

                                <TextBox Text="{Binding PaymentAmountText, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource FormTextBoxStyle}"
                                         FontWeight="Bold"
                                         FontSize="15"/>

                                <Grid Margin="0,10,0,0">
                                    <TextBlock Text="Tiền thừa trả khách (nếu có):" FontSize="13" Foreground="{StaticResource MutedTextBrush}"/>
                                    <TextBlock Text="{Binding FormattedChangeAmount}"
                                               FontSize="14"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource SuccessGreenBrush}"
                                               HorizontalAlignment="Right"/>
                                </Grid>
                            </StackPanel>

                            <!-- Method Business Rule Guide -->
                            <Border Background="{StaticResource BrandDarkBlueLightBrush}"
                                    CornerRadius="8"
                                    Padding="14,10"
                                    Margin="0,0,0,18">
                                <TextBlock Text="{Binding PaymentMethodGuideText}"
                                           FontSize="12.5"
                                           Foreground="{StaticResource BrandDarkBlueBrush}"
                                           TextWrapping="Wrap"
                                           LineHeight="18"/>
                            </Border>

                            <!-- Primary CTA Button: Xác nhận & Hoàn tất -->
                            <Button Content="Xác nhận &amp; Hoàn tất"
                                    Command="{Binding ConfirmPaymentCommand}"
                                    IsEnabled="{Binding SelectedOrder.CanRecordPayment}"
                                    Style="{StaticResource PrimaryCtaButtonStyle}"
                                    FontSize="15"
                                    Padding="0,13"
                                    HorizontalAlignment="Stretch"
                                    Margin="0,0,0,12"/>

                            <!-- Quick Navigation Links -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Button Grid.Column="0"
                                        Content="Đi tới Xuất kho (UC10)"
                                        Command="{Binding GoToStockOutCommand}"
                                        Style="{StaticResource SecondaryOutlineButtonStyle}"
                                        Margin="0,0,6,0"/>

                                <Button Grid.Column="1"
                                        Content="Đi tới Xử lý đơn (UC07)"
                                        Command="{Binding GoToOrderProcessingCommand}"
                                        Style="{StaticResource SecondaryOutlineButtonStyle}"
                                        Margin="6,0,0,0"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

        </StackPanel>
    </ScrollViewer>
</Page>
