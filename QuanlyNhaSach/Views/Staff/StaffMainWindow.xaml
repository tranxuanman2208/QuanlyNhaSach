<Window x:Class="QuanlyNhaSach.Views.Staff.StaffMainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="BookNest — Cổng Quản Trị &amp; Điều Hành Nghiệp Vụ Nhân Viên (Staff Portal)"
        Height="840" Width="1340"
        MinHeight="660" MinWidth="1060"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource SubtleSurfaceBrush}">

    <Grid>
        <Grid.ColumnDefinitions>
            <!-- Fixed Left Administrative Sidebar (#172B4D) -->
            <ColumnDefinition Width="272"/>
            <!-- Right Content Area -->
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ==================== 1. LEFT SIDEBAR (#172B4D) ==================== -->
        <Border Grid.Column="0"
                Background="{StaticResource StaffSidebarBrush}"
                BorderBrush="#0F1D35"
                BorderThickness="0,0,1,0">
            <Grid Margin="20,24">
                <Grid.RowDefinitions>
                    <!-- Brand Header -->
                    <RowDefinition Height="Auto"/>
                    <!-- Authenticated Staff Card -->
                    <RowDefinition Height="Auto"/>
                    <!-- Navigation Menu -->
                    <RowDefinition Height="*"/>
                    <!-- Footer & Logout -->
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- A. Application Brand Logo -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0,4,22">
                    <Border Width="44" Height="44" CornerRadius="12" Background="{StaticResource BrandOrangeBrush}" Margin="0,0,12,0">
                        <Path Data="{StaticResource IconBookGeometry}"
                              Fill="White"
                              Width="22" Height="22"
                              Stretch="Uniform"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding BrandName}"
                                   FontSize="22"
                                   FontWeight="Bold"
                                   Foreground="White"/>
                        <TextBlock Text="{Binding PortalLabel}"
                                   FontSize="10"
                                   FontWeight="Bold"
                                   Foreground="#93C5FD"/>
                    </StackPanel>
                </StackPanel>

                <!-- B. Authenticated Staff Member Profile Card (#1E3A8A) -->
                <Border Grid.Row="1"
                        Background="{StaticResource BrandDarkBlueBrush}"
                        BorderBrush="#2E51B8"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="14,12"
                        Margin="0,0,0,24">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"
                                Width="38" Height="38"
                                CornerRadius="19"
                                Background="{StaticResource BrandOrangeBrush}"
                                Margin="0,0,12,0"
                                VerticalAlignment="Center">
                            <Path Data="{StaticResource IconUserGeometry}"
                                  Fill="White"
                                  Width="18" Height="18"
                                  Stretch="Uniform"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"/>
                        </Border>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding StaffFullName}"
                                       FontSize="13.5"
                                       FontWeight="Bold"
                                       Foreground="White"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding StaffRoleLabel}"
                                       FontSize="11.5"
                                       FontWeight="SemiBold"
                                       Foreground="#FDBA74"
                                       Margin="0,2,0,0"/>
                            <TextBlock Text="{Binding StaffUsername}"
                                       FontSize="10.5"
                                       Foreground="#93C5FD"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- C. Staff Navigation Menu Items (Exact Required Order 1..5) -->
                <StackPanel Grid.Row="2">
                    <TextBlock Text="DANH MỤC NGHIỆP VỤ"
                               FontSize="11"
                               FontWeight="Bold"
                               Foreground="#64748B"
                               Margin="8,0,0,10"/>

                    <!-- 1. Trang chủ — Dashboard -->
                    <Button Command="{Binding NavigateDashboardCommand}"
                            Tag="{Binding DashboardTag}"
                            Style="{StaticResource StaffSidebarNavButtonStyle}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="{StaticResource IconDashboardGeometry}"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  Width="18" Height="18"
                                  Stretch="Uniform"
                                  Margin="0,0,12,0"
                                  VerticalAlignment="Center"/>
                            <TextBlock Text="Trang chủ"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                       FontWeight="{Binding FontWeight, RelativeSource={RelativeSource AncestorType=Button}}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- 2. Tra cứu — Lookup -->
                    <Button Command="{Binding NavigateLookupCommand}"
                            Tag="{Binding LookupTag}"
                            Style="{StaticResource StaffSidebarNavButtonStyle}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="{StaticResource IconSearchGeometry}"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  Width="18" Height="18"
                                  Stretch="Uniform"
                                  Margin="0,0,12,0"
                                  VerticalAlignment="Center"/>
                            <TextBlock Text="Tra cứu"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                       FontWeight="{Binding FontWeight, RelativeSource={RelativeSource AncestorType=Button}}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- 3. Bán hàng — Sales -->
                    <Button Command="{Binding NavigateSalesCommand}"
                            Tag="{Binding SalesTag}"
                            Style="{StaticResource StaffSidebarNavButtonStyle}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="{StaticResource IconSalesGeometry}"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  Width="18" Height="18"
                                  Stretch="Uniform"
                                  Margin="0,0,12,0"
                                  VerticalAlignment="Center"/>
                            <TextBlock Text="Bán hàng"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                       FontWeight="{Binding FontWeight, RelativeSource={RelativeSource AncestorType=Button}}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- 4. Xử lý đơn hàng — Order Processing -->
                    <Button Command="{Binding NavigateOrderProcessingCommand}"
                            Tag="{Binding OrderProcessingTag}"
                            Style="{StaticResource StaffSidebarNavButtonStyle}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="{StaticResource IconOrdersGeometry}"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  Width="18" Height="18"
                                  Stretch="Uniform"
                                  Margin="0,0,12,0"
                                  VerticalAlignment="Center"/>
                            <TextBlock Text="Xử lý đơn hàng"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                       FontWeight="{Binding FontWeight, RelativeSource={RelativeSource AncestorType=Button}}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- 5. Xuất kho — Stock Out -->
                    <Button Command="{Binding NavigateStockOutCommand}"
                            Tag="{Binding StockOutTag}"
                            Style="{StaticResource StaffSidebarNavButtonStyle}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="{StaticResource IconStockOutGeometry}"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  Width="18" Height="18"
                                  Stretch="Uniform"
                                  Margin="0,0,12,0"
                                  VerticalAlignment="Center"/>
                            <TextBlock Text="Xuất kho"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                       FontWeight="{Binding FontWeight, RelativeSource={RelativeSource AncestorType=Button}}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- D. Sidebar Bottom Info & Logout Button -->
                <StackPanel Grid.Row="3">
                    <Border Background="#11203B"
                            CornerRadius="8"
                            Padding="12,8"
                            Margin="0,0,0,12">
                        <TextBlock Text="Trạng thái: Đồng bộ dữ liệu In-Memory"
                                   FontSize="11"
                                   Foreground="#94A3B8"
                                   TextAlignment="Center"/>
                    </Border>

                    <Button Command="{Binding LogoutCommand}"
                            Style="{StaticResource PrimaryCtaButtonStyle}"
                            Background="#DC2626"
                            Padding="14,11"
                            HorizontalAlignment="Stretch">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Path Data="{StaticResource IconLogoutGeometry}"
                                  Fill="White"
                                  Width="16" Height="16"
                                  Stretch="Uniform"
                                  Margin="0,0,8,0"
                                  VerticalAlignment="Center"/>
                            <TextBlock Text="Đăng xuất phiên làm việc"
                                       Foreground="White"
                                       FontWeight="Bold"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ==================== 2. RIGHT CONTENT REGION ==================== -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <!-- Top Page Header Bar -->
                <RowDefinition Height="Auto"/>
                <!-- Dynamic Content Frame -->
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Top Administrative Header Bar -->
            <Border Grid.Row="0"
                    Background="White"
                    BorderBrush="{StaticResource BorderSubtleBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="32,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding CurrentPageTitle}"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource BrandDarkBlueBrush}"/>
                        <TextBlock Text="{Binding CurrentPageSubtitle}"
                                   FontSize="13"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   Margin="0,3,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="{StaticResource BrandDarkBlueLightBrush}"
                                BorderBrush="#BFDBFE"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="12,6">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Nhân viên trực: "
                                           FontSize="12.5"
                                           Foreground="{StaticResource MutedTextBrush}"/>
                                <TextBlock Text="{Binding StaffFullName}"
                                           FontSize="12.5"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource BrandDarkBlueBrush}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Selected Staff Page Frame -->
            <Frame x:Name="StaffContentFrame"
                   Grid.Row="1"
                   NavigationUIVisibility="Hidden"/>
        </Grid>
    </Grid>
</Window>
