<Page x:Class="QuanlyNhaSach.Views.Staff.StaffDashboardPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      mc:Ignorable="d"
      d:DesignHeight="760" d:DesignWidth="1060"
      Title="StaffDashboardPage"
      Background="{StaticResource SubtleSurfaceBrush}">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="32,26,32,36">

            <!-- 1. FOUR REQUIRED ORDER STATISTIC CARDS -->
            <UniformGrid Columns="4" Margin="0,0,0,22">

                <!-- Card 1: Đơn mới -->
                <Border Style="{StaticResource StatCardBorderStyle}" Margin="0,0,14,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="ĐƠN MỚI" FontSize="12" FontWeight="Bold" Foreground="#1E40AF"/>
                            <TextBlock Text="{Binding NewOrdersCount}"
                                       FontSize="34"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource CharcoalTextBrush}"
                                       Margin="0,6,0,4"/>
                            <TextBlock Text="Chờ nhân viên xác nhận" FontSize="12" Foreground="{StaticResource MutedTextBrush}"/>
                        </StackPanel>
                        <Border Grid.Column="1" Width="46" Height="46" CornerRadius="12" Background="#DBEAFE" VerticalAlignment="Top">
                            <Path Data="{StaticResource IconOrdersGeometry}" Fill="#1E40AF" Width="22" Height="22" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                </Border>

                <!-- Card 2: Đang giao -->
                <Border Style="{StaticResource StatCardBorderStyle}" Margin="7,0,7,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="ĐANG GIAO" FontSize="12" FontWeight="Bold" Foreground="#B45309"/>
                            <TextBlock Text="{Binding ShippingOrdersCount}"
                                       FontSize="34"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource CharcoalTextBrush}"
                                       Margin="0,6,0,4"/>
                            <TextBlock Text="Đơn đang vận chuyển" FontSize="12" Foreground="{StaticResource MutedTextBrush}"/>
                        </StackPanel>
                        <Border Grid.Column="1" Width="46" Height="46" CornerRadius="12" Background="#FEF3C7" VerticalAlignment="Top">
                            <Path Data="{StaticResource IconTruckGeometry}" Fill="#B45309" Width="22" Height="22" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                </Border>

                <!-- Card 3: Hoàn tất -->
                <Border Style="{StaticResource StatCardBorderStyle}" Margin="7,0,7,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="HOÀN TẤT" FontSize="12" FontWeight="Bold" Foreground="#15803D"/>
                            <TextBlock Text="{Binding CompletedOrdersCount}"
                                       FontSize="34"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource CharcoalTextBrush}"
                                       Margin="0,6,0,4"/>
                            <TextBlock Text="Đơn đã giao &amp; thu tiền" FontSize="12" Foreground="{StaticResource MutedTextBrush}"/>
                        </StackPanel>
                        <Border Grid.Column="1" Width="46" Height="46" CornerRadius="12" Background="#DCFCE7" VerticalAlignment="Top">
                            <Path Data="{StaticResource IconCheckCircleGeometry}" Fill="#15803D" Width="22" Height="22" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                </Border>

                <!-- Card 4: Đã hủy -->
                <Border Style="{StaticResource StatCardBorderStyle}" Margin="14,0,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="ĐÃ HỦY" FontSize="12" FontWeight="Bold" Foreground="#DC2626"/>
                            <TextBlock Text="{Binding CancelledOrdersCount}"
                                       FontSize="34"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource CharcoalTextBrush}"
                                       Margin="0,6,0,4"/>
                            <TextBlock Text="Đơn đã hủy bỏ" FontSize="12" Foreground="{StaticResource MutedTextBrush}"/>
                        </StackPanel>
                        <Border Grid.Column="1" Width="46" Height="46" CornerRadius="12" Background="#FEE2E2" VerticalAlignment="Top">
                            <Path Data="{StaticResource IconCancelCircleGeometry}" Fill="#DC2626" Width="22" Height="22" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                </Border>
            </UniformGrid>

            <!-- 2. SECONDARY OPERATIONAL SUMMARY BAR -->
            <Border Style="{StaticResource CardPanelStyle}" Padding="20,14" Margin="0,0,0,22">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Đơn đã xác nhận chờ xuất kho/giao: " FontSize="13" Foreground="{StaticResource MutedTextBrush}"/>
                        <TextBlock Text="{Binding ConfirmedOrdersCount, StringFormat='{}{0} đơn'}" FontSize="13.5" FontWeight="Bold" Foreground="{StaticResource BrandDarkBlueBrush}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Doanh thu đơn hoàn tất: " FontSize="13" Foreground="{StaticResource MutedTextBrush}"/>
                        <TextBlock Text="{Binding FormattedCompletedRevenue}" FontSize="13.5" FontWeight="Bold" Foreground="{StaticResource SuccessGreenBrush}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Đầu sách tồn kho thấp (&lt;= 5 cuốn): " FontSize="13" Foreground="{StaticResource MutedTextBrush}"/>
                        <TextBlock Text="{Binding LowStockBooksCount, StringFormat='{}{0} đầu sách'}" FontSize="13.5" FontWeight="Bold" Foreground="{StaticResource WarningAmberBrush}"/>
                    </StackPanel>

                    <Button Grid.Column="3"
                            Content="Làm mới số liệu"
                            Command="{Binding RefreshDashboardCommand}"
                            Style="{StaticResource SecondaryOutlineButtonStyle}"
                            Padding="12,6"/>
                </Grid>
            </Border>

            <!-- 3. URGENT ORDER LIST ("Đơn hàng cần xử lý gấp") -->
            <Border Style="{StaticResource CardPanelStyle}" Padding="24">
                <StackPanel>
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Đơn hàng cần xử lý gấp" Style="{StaticResource SectionHeadingStyle}"/>
                                <Border Background="{StaticResource BrandOrangeLightBrush}"
                                        BorderBrush="{StaticResource BrandOrangeBrush}"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        Padding="10,2"
                                        Margin="12,0,0,0"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="{Binding UrgentOrdersCount, StringFormat='{}{0} đơn cần xử lý'}"
                                               Foreground="{StaticResource BrandOrangeBrush}"
                                               FontWeight="Bold"
                                               FontSize="12"/>
                                </Border>
                            </StackPanel>
                            <TextBlock Text="Danh sách các đơn hàng Mới, Đã xác nhận chờ xuất kho, hoặc Đang giao chờ thu tiền &amp; hoàn tất."
                                       FontSize="13"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       Margin="0,4,0,0"/>
                        </StackPanel>
                    </Grid>

                    <!-- Urgent Orders DataGrid -->
                    <DataGrid ItemsSource="{Binding UrgentOrders}"
                              Style="{StaticResource AdminDataGridStyle}"
                              Visibility="{Binding HasUrgentOrders, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <DataGrid.Columns>
                            <!-- Order ID -->
                            <DataGridTextColumn Header="Mã ĐH" Binding="{Binding OrderCode}" Width="85">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Setter Property="Foreground" Value="{StaticResource BrandDarkBlueBrush}"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- Customer -->
                            <DataGridTemplateColumn Header="Khách hàng" Width="1.2*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel>
                                            <TextBlock Text="{Binding HoTenKhachHang}" FontWeight="SemiBold" Foreground="{StaticResource CharcoalTextBrush}"/>
                                            <TextBlock Text="{Binding SDTKhachHang}" FontSize="11.5" Foreground="{StaticResource MutedTextBrush}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Order Date -->
                            <DataGridTextColumn Header="Ngày đặt" Binding="{Binding FormattedNgayDat}" Width="130"/>

                            <!-- Total Amount -->
                            <DataGridTextColumn Header="Tổng tiền" Binding="{Binding FormattedTongTien}" Width="115">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Setter Property="Foreground" Value="{StaticResource BrandOrangeBrush}"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- Current Status -->
                            <DataGridTemplateColumn Header="Trạng thái" Width="125">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource StatusBadgeBorderStyle}"
                                                Background="{Binding TrangThai, Converter={StaticResource OrderStatusBadgeBackgroundConverter}}">
                                            <TextBlock Text="{Binding TrangThai}"
                                                       FontWeight="Bold"
                                                       FontSize="11.5"
                                                       Foreground="{Binding TrangThai, Converter={StaticResource OrderStatusBadgeForegroundConverter}}"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Stock-Out Status -->
                            <DataGridTemplateColumn Header="Xuất kho" Width="125">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource StatusBadgeBorderStyle}"
                                                Background="{Binding TrangThaiXuatKho, Converter={StaticResource StockOutStatusBadgeBackgroundConverter}}">
                                            <TextBlock Text="{Binding TrangThaiXuatKho}"
                                                       FontWeight="Bold"
                                                       FontSize="11.5"
                                                       Foreground="{Binding TrangThaiXuatKho, Converter={StaticResource StockOutStatusBadgeForegroundConverter}}"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Required Action -->
                            <DataGridTextColumn Header="Hành động cần thực hiện" Binding="{Binding RequiredActionText}" Width="1.5*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Setter Property="Foreground" Value="{StaticResource BodyTextBrush}"/>
                                        <Setter Property="TextWrapping" Value="Wrap"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- Action Buttons -->
                            <DataGridTemplateColumn Header="Thao tác" Width="210">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="Xử lý đơn"
                                                    Command="{Binding DataContext.ProcessOrderCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource PrimaryCtaButtonStyle}"
                                                    FontSize="12"
                                                    Padding="11,6"
                                                    Margin="0,0,6,0"/>

                                            <Button Content="Xuất kho"
                                                    Command="{Binding DataContext.GoToStockOutCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource SecondaryOutlineButtonStyle}"
                                                    FontSize="12"
                                                    Padding="10,6"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Empty Urgent Orders State -->
                    <Border Background="{StaticResource SubtleSurfaceBrush}"
                            CornerRadius="10"
                            Padding="36,28"
                            Visibility="{Binding IsUrgentOrdersEmpty, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="Tất cả đơn hàng đã được xử lý hoàn tất!"
                                       FontSize="16"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource SuccessGreenBrush}"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="Hiện không có đơn hàng nào đang chờ xử lý gấp trong phiên làm việc."
                                       FontSize="13"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       HorizontalAlignment="Center"
                                       Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
