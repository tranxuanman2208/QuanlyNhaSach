<Page x:Class="QuanlyNhaSach.Views.Staff.StaffLookupPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      mc:Ignorable="d"
      d:DesignHeight="760" d:DesignWidth="1060"
      Title="StaffLookupPage"
      Background="{StaticResource SubtleSurfaceBrush}">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="32,26,32,36">

            <!-- 1. SEARCH & SCOPE FILTER CARD -->
            <Border Style="{StaticResource CardPanelStyle}" Padding="24,20" Margin="0,0,0,22">
                <StackPanel>
                    <TextBlock Text="Tìm Kiếm &amp; Tra Cứu Tổng Hợp" Style="{StaticResource SectionHeadingStyle}" Margin="0,0,0,6"/>
                    <TextBlock Text="Tra cứu nhanh theo Mã đơn hàng (#1001), Tên khách hàng, Số điện thoại, Mã sách (#1) hoặc Tên sách."
                               FontSize="13"
                               Foreground="{StaticResource MutedTextBrush}"
                               Margin="0,0,0,16"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="230"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Keyword Input -->
                        <TextBox Grid.Column="0"
                                 Text="{Binding SearchKeyword, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource FormTextBoxStyle}"
                                 Margin="0,0,12,0">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Return" Command="{Binding ExecuteLookupCommand}"/>
                                <KeyBinding Key="Enter" Command="{Binding ExecuteLookupCommand}"/>
                            </TextBox.InputBindings>
                        </TextBox>

                        <!-- Scope Selector -->
                        <ComboBox Grid.Column="1"
                                  ItemsSource="{Binding SearchScopes}"
                                  SelectedItem="{Binding SelectedScope, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  Style="{StaticResource FormComboBoxStyle}"
                                  Margin="0,0,12,0"/>

                        <!-- Search Button -->
                        <Button Grid.Column="2"
                                Content="Tra cứu ngay"
                                Command="{Binding ExecuteLookupCommand}"
                                Style="{StaticResource PrimaryCtaButtonStyle}"
                                Padding="20,9"
                                Margin="0,0,8,0"/>

                        <!-- Clear Button -->
                        <Button Grid.Column="3"
                                Content="Đặt lại"
                                Command="{Binding ClearLookupCommand}"
                                Style="{StaticResource SecondaryOutlineButtonStyle}"
                                Padding="16,9"/>
                    </Grid>

                    <TextBlock Text="{Binding ResultSummary}"
                               FontSize="12.5"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource BrandDarkBlueBrush}"
                               Margin="0,12,0,0"/>
                </StackPanel>
            </Border>

            <!-- 2. MATCHING ORDERS SECTION -->
            <Border Style="{StaticResource CardPanelStyle}"
                    Padding="24"
                    Margin="0,0,0,22"
                    Visibility="{Binding ShowOrdersSection, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                        <TextBlock Text="Danh Sách Đơn Hàng &amp; Khách Hàng Phù Hợp" Style="{StaticResource SectionHeadingStyle}"/>
                        <Border Background="{StaticResource BrandDarkBlueLightBrush}" CornerRadius="10" Padding="10,2" Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding MatchedOrders.Count, StringFormat='{}{0} đơn hàng'}"
                                       Foreground="{StaticResource BrandDarkBlueBrush}"
                                       FontWeight="Bold"
                                       FontSize="12"/>
                        </Border>
                    </StackPanel>

                    <DataGrid ItemsSource="{Binding MatchedOrders}"
                              Style="{StaticResource AdminDataGridStyle}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Mã ĐH" Binding="{Binding OrderCode}" Width="85">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Setter Property="Foreground" Value="{StaticResource BrandDarkBlueBrush}"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTemplateColumn Header="Khách hàng" Width="1.1*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel>
                                            <TextBlock Text="{Binding HoTenKhachHang}" FontWeight="SemiBold" Foreground="{StaticResource CharcoalTextBrush}"/>
                                            <TextBlock Text="{Binding SDTKhachHang}" FontSize="11.5" Foreground="{StaticResource MutedTextBrush}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="Sách trong đơn" Binding="{Binding BooksSummary}" Width="1.5*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextWrapping" Value="Wrap"/>
                                        <Setter Property="FontSize" Value="12.5"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn Header="Tổng tiền" Binding="{Binding FormattedTongTien}" Width="115">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Setter Property="Foreground" Value="{StaticResource BrandOrangeBrush}"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTemplateColumn Header="Trạng thái đơn" Width="120">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource StatusBadgeBorderStyle}"
                                                Background="{Binding TrangThai, Converter={StaticResource OrderStatusBadgeBackgroundConverter}}">
                                            <TextBlock Text="{Binding TrangThai}"
                                                       FontWeight="Bold"
                                                       FontSize="11.5"
                                                       Foreground="{Binding TrangThai, Converter={StaticResource OrderStatusBadgeForegroundConverter}}"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="Thanh toán" Width="130">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource StatusBadgeBorderStyle}"
                                                Background="{Binding TrangThaiThanhToan, Converter={StaticResource PaymentStatusBadgeBackgroundConverter}}">
                                            <TextBlock Text="{Binding TrangThaiThanhToan}"
                                                       FontWeight="Bold"
                                                       FontSize="11.5"
                                                       Foreground="{Binding TrangThaiThanhToan, Converter={StaticResource PaymentStatusBadgeForegroundConverter}}"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="Điều hướng nhanh" Width="230">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="Xử lý đơn"
                                                    Command="{Binding DataContext.OpenOrderProcessingCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource SecondaryOutlineButtonStyle}"
                                                    FontSize="11.5"
                                                    Padding="8,5"
                                                    Margin="0,0,5,0"/>
                                            <Button Content="Thu tiền"
                                                    Command="{Binding DataContext.OpenSalesCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource SecondaryOutlineButtonStyle}"
                                                    FontSize="11.5"
                                                    Padding="8,5"
                                                    Margin="0,0,5,0"/>
                                            <Button Content="Xuất kho"
                                                    Command="{Binding DataContext.OpenStockOutCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource SecondaryOutlineButtonStyle}"
                                                    FontSize="11.5"
                                                    Padding="8,5"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>

            <!-- 3. MATCHING BOOKS SECTION -->
            <Border Style="{StaticResource CardPanelStyle}"
                    Padding="24"
                    Margin="0,0,0,22"
                    Visibility="{Binding ShowBooksSection, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                        <TextBlock Text="Danh Mục Sách &amp; Tồn Kho Phù Hợp" Style="{StaticResource SectionHeadingStyle}"/>
                        <Border Background="{StaticResource BrandDarkBlueLightBrush}" CornerRadius="10" Padding="10,2" Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding MatchedBooks.Count, StringFormat='{}{0} đầu sách'}"
                                       Foreground="{StaticResource BrandDarkBlueBrush}"
                                       FontWeight="Bold"
                                       FontSize="12"/>
                        </Border>
                    </StackPanel>

                    <DataGrid ItemsSource="{Binding MatchedBooks}"
                              Style="{StaticResource AdminDataGridStyle}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Mã sách" Binding="{Binding MaSach, StringFormat='#{0}'}" Width="90">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Setter Property="Foreground" Value="{StaticResource BrandDarkBlueBrush}"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn Header="Tên sách" Binding="{Binding TenSach}" Width="1.8*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Setter Property="Foreground" Value="{StaticResource CharcoalTextBrush}"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn Header="Tác giả" Binding="{Binding TacGia}" Width="1.2*"/>

                            <DataGridTextColumn Header="Giá bán" Binding="{Binding FormattedPrice}" Width="130">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Setter Property="Foreground" Value="{StaticResource BrandOrangeBrush}"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn Header="Số lượng tồn" Binding="{Binding SoLuongTon}" Width="115">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontWeight" Value="Bold"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTemplateColumn Header="Trạng thái kho" Width="160">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource StatusBadgeBorderStyle}"
                                                Background="{Binding SoLuongTon, Converter={StaticResource StockBadgeBackgroundConverter}}">
                                            <TextBlock Text="{Binding StockStatusText}"
                                                       FontWeight="Bold"
                                                       FontSize="11.5"
                                                       Foreground="{Binding SoLuongTon, Converter={StaticResource StockBadgeForegroundConverter}}"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>

            <!-- 4. EMPTY NO-RESULTS STATE -->
            <Border Style="{StaticResource CardPanelStyle}"
                    Padding="48,40"
                    Visibility="{Binding IsNoResults, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel HorizontalAlignment="Center" MaxWidth="440">
                    <Path Data="{StaticResource IconSearchGeometry}"
                          Fill="{StaticResource BrandDarkBlueBrush}"
                          Width="40" Height="40"
                          Stretch="Uniform"
                          HorizontalAlignment="Center"
                          Margin="0,0,0,14"/>
                    <TextBlock Text="Không tìm thấy kết quả phù hợp"
                               FontSize="19"
                               FontWeight="Bold"
                               Foreground="{StaticResource BrandDarkBlueBrush}"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,8"/>
                    <TextBlock Text="Không có đơn hàng hoặc đầu sách nào khớp với từ khóa và phạm vi lọc đã chọn."
                               FontSize="13.5"
                               Foreground="{StaticResource MutedTextBrush}"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               Margin="0,0,0,18"/>
                    <Button Content="Hiển thị toàn bộ dữ liệu"
                            Command="{Binding ClearLookupCommand}"
                            Style="{StaticResource PrimaryCtaButtonStyle}"
                            HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
