{
    // Cấu hình SMTP gửi mã xác thực tài khoản.
    // Với Gmail: bật Xác minh 2 bước rồi tạo "Mật khẩu ứng dụng" (App Password) tại
    // https://myaccount.google.com/apppasswords và dán vào AppPassword (16 ký tự, không khoảng trắng).
    "SmtpHost": "smtp.gmail.com",
    "SmtpPort": 587,
    "EnableSsl": true,
    "SenderEmail": "a@gmail.com",
    "SenderName": "Hệ thống nhà sách",
    "AppPassword": "", //16 kí tự mật khẩu ứng dụng không khoảng trắng
    "CodeLength": 6,
    "CodeExpiryMinutes": 10,
    "MaxVerifyAttempts": 5
}
